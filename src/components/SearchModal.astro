---
/** Global search modal — Ctrl/Cmd+K, keyboard navigation, intent-based results. */
import Icon from './Icon.astro';
---

<div class="modal-overlay" data-search-overlay hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-label="Search tools">
    <div class="sm-head">
      <Icon name="search" size={18} />
      <input
        type="search"
        class="sm-input"
        placeholder="What do you want to do?"
        aria-label="Search tools"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <kbd>Esc</kbd>
    </div>
    <div class="sm-results" data-search-results role="listbox" aria-label="Search results"></div>
    <div class="sm-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  .sm-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    color: var(--faint);
  }

  .sm-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 1.05rem;
    color: var(--text);
  }

  .sm-input::placeholder {
    color: var(--faint);
  }

  .sm-results {
    overflow-y: auto;
    padding: 10px;
    flex: 1;
  }

  .sm-group {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--faint);
    padding: 14px 12px 6px;
  }

  .sm-item {
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
    padding: 11px 12px;
    border-radius: 12px;
    text-align: left;
    color: var(--text);
    border: 1px solid transparent;
    transition: background 0.12s;
  }

  .sm-item.is-active,
  .sm-item:hover {
    background: var(--panel-strong);
  }

  .sm-item.is-active {
    border-color: var(--border-strong);
  }

  .sm-item-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 10px;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 12%, transparent);
  }

  .sm-item-name {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .sm-item-desc {
    font-size: 0.79rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sm-empty {
    padding: 34px 20px;
    text-align: center;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .sm-group-flow {
    color: var(--accent);
  }

  .sm-flow-item {
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
    padding: 11px 12px;
    border-radius: 12px;
    text-align: left;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 4px;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    transition: background 0.12s;
  }

  .sm-flow-item:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .sm-flow-icon {
    color: var(--accent) !important;
    background: color-mix(in srgb, var(--accent) 14%, transparent) !important;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .sm-foot {
    display: flex;
    gap: 18px;
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.75rem;
  }

  .sm-foot span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  @media (max-width: 560px) {
    .modal-overlay {
      padding: 8vh 12px 12px;
    }
    .sm-foot span:not(:last-child) {
      display: none;
    }
  }
</style>

<script>
  import { tools } from '../data/tools.js';
  import { getCategory } from '../data/site.js';
  import { searchTools } from '../lib/search.js';
  import { ICON_PATHS } from '../lib/icons.js';
  import { detectFlow, describeFlowPlan } from '../lib/flow.js';
  import { t } from '../lib/i18n.js';

  /** Turn a Flow plan into a real, safe destination URL (never executes anything). */
  function flowHref(flowPlan) {
    if (flowPlan.cta.type === 'workflow') {
      return `/workflows/?plan=${encodeURIComponent(JSON.stringify(flowPlan.cta.steps))}`;
    }
    const params = new URLSearchParams(flowPlan.cta.params || {});
    const qs = params.toString();
    return `/tools/${flowPlan.cta.slug}/${qs ? `?${qs}` : ''}`;
  }

  const overlay = document.querySelector('[data-search-overlay]');
  const input = overlay?.querySelector('[data-search-input]');
  const resultsEl = overlay?.querySelector('[data-search-results]');
  let lastFocused = null;
  let flat = [];
  let activeIndex = -1;

  function render(list, query = '') {
    resultsEl.innerHTML = '';
    flat = [];
    activeIndex = -1;

    // V4 Flow — natural-language plan shown above the tool results.
    // Deliberately NOT part of the keyboard `flat` list: it is a bonus
    // suggestion, so the first tool result stays the Enter default.
    const flowPlan = query ? detectFlow(query) : null;
    if (flowPlan) {
      const h = document.createElement('div');
      h.className = 'sm-group sm-group-flow';
      h.textContent = t('search.flowGroup');
      resultsEl.appendChild(h);
      const btn = document.createElement('a');
      btn.className = 'sm-flow-item';
      btn.href = flowHref(flowPlan);
      btn.setAttribute('data-flow-result', '');
      btn.innerHTML = `
        <span class="sm-item-icon sm-flow-icon" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS.bolt || ''}</svg>
        </span>
        <span style="min-width:0">
          <span class="sm-item-name"></span><br>
          <span class="sm-item-desc"></span>
        </span>`;
      btn.querySelector('.sm-item-name').textContent = flowPlan.title;
      btn.querySelector('.sm-item-desc').textContent =
        flowPlan.cta.type === 'workflow' ? `${describeFlowPlan(flowPlan)} — opens in the Workflow builder, nothing runs automatically` : flowPlan.detail;
      resultsEl.appendChild(btn);
    }

    if (!list.length && !flowPlan) {
      resultsEl.innerHTML = `<div class="sm-empty">${t('search.emptyBefore')} “${escapeHtml(query)}”.<br>${t('search.emptyAfter')}</div>`;
      return;
    }
    if (!list.length) {
      setActive(0);
      return;
    }

    let currentCat = null;
    for (const tool of list) {
      const cat = getCategory(tool.category);
      if (cat.name !== currentCat) {
        currentCat = cat.name;
        const h = document.createElement('div');
        h.className = 'sm-group';
        h.textContent = cat.name;
        resultsEl.appendChild(h);
      }
      const btn = document.createElement('a');
      btn.className = 'sm-item';
      btn.href = `/tools/${tool.slug}/`;
      btn.setAttribute('role', 'option');
      btn.innerHTML = `
        <span class="sm-item-icon" style="--hue:${cat.hue}" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[tool.icon] || ''}</svg>
        </span>
        <span style="min-width:0">
          <span class="sm-item-name"></span><br>
          <span class="sm-item-desc"></span>
        </span>`;
      btn.querySelector('.sm-item-name').textContent = tool.name;
      btn.querySelector('.sm-item-desc').textContent = tool.shortDesc;
      btn.dataset.index = flat.length;
      flat.push(btn);
      resultsEl.appendChild(btn);
    }
    setActive(0);
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function setActive(i) {
    if (!flat.length) return;
    activeIndex = (i + flat.length) % flat.length;
    flat.forEach((el, idx) => el.classList.toggle('is-active', idx === activeIndex));
    flat[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function open(preset = '') {
    if (!overlay) return;
    lastFocused = document.activeElement;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = preset;
    render(preset ? searchTools(preset, tools) : tools, preset);
    requestAnimationFrame(() => input.focus());
  }

  function close() {
    if (!overlay || overlay.hidden) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
    if (lastFocused?.matches?.('[data-hero-search]')) {
      // Never refocus the hero bar: focusing it would re-open the modal.
      lastFocused.blur();
      lastFocused.value = '';
    } else {
      lastFocused?.focus?.();
    }
  }

  input?.addEventListener('input', () => {
    const q = input.value.trim();
    render(q ? searchTools(q, tools) : tools, q);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const target = flat[activeIndex] || flat[0];
      if (target) location.href = target.href;
    }
  });

  resultsEl?.addEventListener('pointermove', (e) => {
    const item = e.target.closest('.sm-item');
    if (item) setActive(Number(item.dataset.index));
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  // Keep Tab focus inside the dialog while it is open
  overlay?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || overlay.hidden) return;
    const focusables = [...overlay.querySelectorAll('input, a[href], button')].filter((el) => !el.disabled);
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && (document.activeElement === first || document.activeElement === overlay)) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.hidden ? open() : close();
    } else if (e.key === 'Escape') {
      close();
    } else if (e.key === '/' && overlay.hidden) {
      const t = e.target;
      const typing = t instanceof HTMLElement && (t.matches('input, textarea, select') || t.isContentEditable);
      if (!typing) {
        e.preventDefault();
        open();
      }
    }
  });

  document.querySelectorAll('[data-search-open]').forEach((el) => {
    el.addEventListener('click', () => open());
  });

  // V4 Flow — example chips open the modal with a ready-made sentence
  document.querySelectorAll('[data-flow-example]').forEach((el) => {
    el.addEventListener('click', () => open(el.dataset.flowExample || ''));
  });

  // The hero search bar opens the modal and transfers the typed text
  document.querySelectorAll('[data-hero-search]').forEach((el) => {
    el.addEventListener('focus', () => {
      const v = el.value || '';
      el.blur();
      open(v);
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const v = el.value || '';
        open(v);
      }
    });
  });
</script>
