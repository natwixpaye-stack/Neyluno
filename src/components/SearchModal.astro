---
/** Recherche globale (modal) — Ctrl/Cmd+K, navigation clavier, résultats groupés par catégorie. */
import Icon from './Icon.astro';
---

<div class="modal-overlay" data-search-overlay hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-label="Rechercher un outil">
    <div class="sm-head">
      <Icon name="search" size={18} />
      <input
        type="search"
        class="sm-input"
        placeholder="Que veux-tu faire ?"
        aria-label="Rechercher un outil"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <kbd>Esc</kbd>
    </div>
    <div class="sm-results" data-search-results role="listbox" aria-label="Résultats de recherche"></div>
    <div class="sm-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> naviguer</span>
      <span><kbd>↵</kbd> ouvrir</span>
      <span><kbd>esc</kbd> fermer</span>
    </div>
  </div>
</div>

<style>
  .sm-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    color: var(--faint);
  }

  .sm-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 1.05rem;
    color: var(--text);
  }

  .sm-input::placeholder {
    color: var(--faint);
  }

  .sm-results {
    overflow-y: auto;
    padding: 10px;
    flex: 1;
  }

  .sm-group {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--faint);
    padding: 14px 12px 6px;
  }

  .sm-item {
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
    padding: 11px 12px;
    border-radius: 12px;
    text-align: left;
    color: var(--text);
    border: 1px solid transparent;
    transition: background 0.12s;
  }

  .sm-item.is-active,
  .sm-item:hover {
    background: var(--panel-strong);
  }

  .sm-item.is-active {
    border-color: var(--border-strong);
  }

  .sm-item-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 10px;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 12%, transparent);
  }

  .sm-item-name {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .sm-item-desc {
    font-size: 0.79rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sm-empty {
    padding: 34px 20px;
    text-align: center;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .sm-foot {
    display: flex;
    gap: 18px;
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.75rem;
  }

  .sm-foot span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  @media (max-width: 560px) {
    .modal-overlay {
      padding: 8vh 12px 12px;
    }
    .sm-foot span:not(:last-child) {
      display: none;
    }
  }
</style>

<script>
  import { tools } from '../data/tools.js';
  import { getCategory } from '../data/site.js';
  import { searchTools } from '../lib/search.js';

  const overlay = document.querySelector('[data-search-overlay]');
  const input = overlay?.querySelector('[data-search-input]');
  const resultsEl = overlay?.querySelector('[data-search-results]');
  let lastFocused = null;
  let flat = [];
  let activeIndex = -1;

  const ICONS = {
    'img-convert': '<rect x="3" y="5" width="13" height="13" rx="2.5"/><path d="m3.5 15.5 3.2-3.2 2.8 2.8 2.2-2.2"/><circle cx="7.8" cy="9.2" r="1.1"/><path d="M17.5 12h3.8m0 0-1.6-1.6m1.6 1.6-1.6 1.6"/>',
    compress: '<path d="M9 4v4.5H4"/><path d="M15 4v4.5h5"/><path d="M9 20v-4.5H4"/><path d="M15 20v-4.5h5"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/>',
    resize: '<rect x="4" y="4" width="12" height="12" rx="2"/><path d="M20 11v7a2 2 0 0 1-2 2h-7"/><path d="m13 13 6.5 6.5M19.5 15v4.5H15"/>',
    'img-pdf': '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/><path d="m7.5 16.5 2.2-2.4 1.8 1.8 2.2-2.6 2.3 3.2"/><circle cx="9.3" cy="11.8" r="1"/>',
    merge: '<rect x="4" y="4" width="11" height="14" rx="2"/><path d="M19 8v10a2 2 0 0 1-2 2h-6"/><path d="M9 11h4m-2-2v4"/>',
    qr: '<rect x="4" y="4" width="6" height="6" rx="1.2"/><rect x="14" y="4" width="6" height="6" rx="1.2"/><rect x="4" y="14" width="6" height="6" rx="1.2"/><path d="M14 14h2.5v2.5H14zM17.5 17.5H20V20h-2.5z"/>',
    percent: '<path d="M18.5 5.5 5.5 18.5"/><circle cx="7.5" cy="7.5" r="2.3"/><circle cx="16.5" cy="16.5" r="2.3"/>',
    password: '<circle cx="8.5" cy="9.5" r="4.2"/><path d="m11.8 12.8 7.4 7.4M16.5 17.5l2.2-2.2M14 15l1.6-1.6"/>',
    counter: '<path d="M4 6h16M4 10h16M4 14h10M4 18h6"/>',
  };

  function render(list) {
    resultsEl.innerHTML = '';
    flat = [];
    activeIndex = -1;

    if (!list.length) {
      resultsEl.innerHTML = `<div class="sm-empty">Aucun outil trouvé.<br>Essayez « image », « pdf », « qr »…</div>`;
      return;
    }

    let currentCat = null;
    for (const tool of list) {
      const cat = getCategory(tool.category);
      if (cat.name !== currentCat) {
        currentCat = cat.name;
        const h = document.createElement('div');
        h.className = 'sm-group';
        h.textContent = cat.name;
        resultsEl.appendChild(h);
      }
      const btn = document.createElement('a');
      btn.className = 'sm-item';
      btn.href = `/outils/${tool.slug}/`;
      btn.setAttribute('role', 'option');
      btn.innerHTML = `
        <span class="sm-item-icon" style="--hue:${cat.hue}" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
        </span>
        <span style="min-width:0">
          <span class="sm-item-name"></span><br>
          <span class="sm-item-desc"></span>
        </span>`;
      btn.querySelector('.sm-item-name').textContent = tool.name;
      btn.querySelector('.sm-item-desc').textContent = tool.shortDesc;
      btn.dataset.index = flat.length;
      flat.push(btn);
      resultsEl.appendChild(btn);
    }
    setActive(0);
  }

  function setActive(i) {
    if (!flat.length) return;
    activeIndex = (i + flat.length) % flat.length;
    flat.forEach((el, idx) => el.classList.toggle('is-active', idx === activeIndex));
    flat[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function open(preset = '') {
    if (!overlay) return;
    lastFocused = document.activeElement;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = preset;
    render(preset ? searchTools(preset, tools) : tools);
    requestAnimationFrame(() => input.focus());
  }

  function close() {
    if (!overlay || overlay.hidden) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
    if (lastFocused?.matches?.('[data-hero-search]')) {
      // Surtout pas redonner le focus à la barre hero : son focus rouvrirait la modale.
      lastFocused.blur();
      lastFocused.value = '';
    } else {
      lastFocused?.focus?.();
    }
  }

  input?.addEventListener('input', () => {
    const q = input.value.trim();
    render(q ? searchTools(q, tools) : tools);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const target = flat[activeIndex] || flat[0];
      if (target) location.href = target.href;
    }
  });

  resultsEl?.addEventListener('pointermove', (e) => {
    const item = e.target.closest('.sm-item');
    if (item) setActive(Number(item.dataset.index));
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.hidden ? open() : close();
    } else if (e.key === 'Escape') {
      close();
    }
  });

  document.querySelectorAll('[data-search-open]').forEach((el) => {
    el.addEventListener('click', () => open());
  });

  // La barre de recherche du hero ouvre la modale et transfère la saisie
  document.querySelectorAll('[data-hero-search]').forEach((el) => {
    el.addEventListener('focus', () => {
      const v = el.value || '';
      el.blur();
      open(v);
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const v = el.value || '';
        open(v);
      }
    });
  });
</script>
