---
/** Outils similaires — réutilise ToolCard en version compacte. */
import ToolCard from './ToolCard.astro';
const { tools = [] } = Astro.props;
---

{
  tools.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">Outils similaires</h2>
      <div class="related-grid">
        {tools.map((t) => <ToolCard tool={t} compact />)}
      </div>
    </section>
  )
}

<style>
  .related h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }
</style>
