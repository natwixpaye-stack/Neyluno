---
import Icon from './Icon.astro';
import { site } from '../data/site.js';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — Home`}>
      <span class="brand-mark" aria-hidden="true"><Icon name="logo" size={26} /></span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      <a href="/tools/">Tools</a>
      <a href="/workflows/">Workflows</a>
      <a href="/categories/">Categories</a>
      <a href="/guides/">Guides</a>
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger" data-search-open aria-label="Search tools (shortcut Ctrl+K)">
        <Icon name="search" size={16} />
        <span class="search-trigger-text">What do you want to do?</span>
        <kbd>Ctrl K</kbd>
      </button>

      <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Theme: dark — switch to light">
        <span data-icon-moon data-active="true"><Icon name="moon" size={17} /></span>
        <span data-icon-sun data-active="false"><Icon name="sun" size={17} /></span>
        <span data-icon-sys data-active="false"><Icon name="monitor" size={17} /></span>
      </button>

      <a href="/settings/" class="icon-btn settings-link" aria-label="Settings" title="Settings">
        <Icon name="settings" size={18} />
      </a>

      <button type="button" class="icon-btn nav-burger" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
    <a href="/tools/">Tools</a>
    <a href="/workflows/">Workflows</a>
    <a href="/categories/">Categories</a>
    <a href="/guides/">Guides</a>
    <a href="/about/">About</a>
    <a href="/settings/">Settings</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }

  .site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }

  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--accent-grad);
    color: #241203;
    box-shadow: 0 6px 18px -6px var(--glow);
  }

  .main-nav {
    display: flex;
    gap: 4px;
    margin-left: 8px;
  }

  .main-nav a {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.18s, background 0.18s;
  }

  .main-nav a:hover {
    color: var(--text);
    background: var(--panel-strong);
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--faint);
    font-size: 0.85rem;
    transition: border-color 0.18s, color 0.18s, background 0.18s;
  }

  .search-trigger:hover {
    border-color: var(--border-strong);
    color: var(--muted);
  }

  .theme-toggle span {
    display: none;
    line-height: 0;
  }

  .theme-toggle span[data-active='true'] {
    display: inline-flex;
  }

  .nav-burger {
    display: none;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 20px 20px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(16px);
  }

  .mobile-nav a:not(.btn) {
    padding: 12px 10px;
    border-radius: 10px;
    font-weight: 500;
    color: var(--muted);
  }

  .mobile-nav a:not(.btn):hover {
    background: var(--panel-strong);
    color: var(--text);
  }

  @media (max-width: 900px) {
    .main-nav {
      display: none;
    }
    .nav-burger {
      display: inline-flex;
    }
  }

  @media (max-width: 400px) {
    .brand-name {
      display: none;
    }
    .header-inner {
      gap: 12px;
    }
    .header-actions {
      gap: 6px;
    }
  }

  @media (max-width: 620px) {
    .search-trigger-text {
      display: none;
    }
    .search-trigger kbd {
      display: none;
    }
    .search-trigger {
      width: 44px;
      height: 44px;
      justify-content: center;
      padding: 0;
      border-radius: 12px;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = header?.querySelector('[data-nav-toggle]');
  const mobileNav = document.getElementById('mobile-nav');

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  burger?.addEventListener('click', () => {
    const open = mobileNav.hidden;
    mobileNav.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    burger.innerHTML = open
      ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>'
      : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
  });

  // Close the mobile menu after navigating
  mobileNav?.addEventListener('click', (e) => {
    if (e.target.closest('a')) {
      mobileNav.hidden = true;
      burger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Escape closes the mobile menu and restores focus to the burger
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav && !mobileNav.hidden) {
      mobileNav.hidden = true;
      burger?.setAttribute('aria-expanded', 'false');
      burger?.focus();
    }
  });

  // Show the right shortcut hint on Mac keyboards
  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    header?.querySelector('.search-trigger kbd')?.replaceChildren('⌘ K');
  }
</script>
