---
import Icon from '../../components/Icon.astro';
---

<div class="pw-tool" id="tool-password">
  <div class="pw-output">
    <output class="pw-value" data-output aria-live="polite">••••••••••••••••</output>
    <div class="pw-actions">
      <button type="button" class="btn btn-primary btn-sm" data-copy>
        <Icon name="copy" size={15} /> Copier
      </button>
      <button type="button" class="btn btn-ghost btn-sm" data-regen>
        <Icon name="refresh" size={15} /> Régénérer
      </button>
    </div>
  </div>

  <div class="pw-meter" role="status" aria-label="Robustesse du mot de passe">
    <div class="pw-segments" data-segments aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <span class="pw-meter-label" data-strength-label>—</span>
    <span class="pw-meter-bits" data-strength-bits></span>
  </div>

  <div class="pw-options">
    <div class="field">
      <label for="pw-len">Longueur <output data-len-out>16</output></label>
      <input type="range" id="pw-len" min="4" max="48" value="16" data-length />
    </div>

    <div class="pw-checks" role="group" aria-label="Caractères autorisés">
      <label class="pill-check"><input type="checkbox" checked data-opt-upper /><span class="dot" aria-hidden="true"></span>Majuscules (A-Z)</label>
      <label class="pill-check"><input type="checkbox" checked data-opt-lower /><span class="dot" aria-hidden="true"></span>Minuscules (a-z)</label>
      <label class="pill-check"><input type="checkbox" checked data-opt-digits /><span class="dot" aria-hidden="true"></span>Chiffres (0-9)</label>
      <label class="pill-check"><input type="checkbox" checked data-opt-symbols /><span class="dot" aria-hidden="true"></span>Symboles (!@#…)</label>
      <label class="pill-check"><input type="checkbox" data-opt-noamb /><span class="dot" aria-hidden="true"></span>Exclure les caractères ambigus (l, 1, O, 0…)</label>
    </div>

    <p class="pw-note" data-note hidden>
      Sélectionnez au moins une famille de caractères pour générer un mot de passe.
    </p>
  </div>

  <p class="pw-privacy">
    <Icon name="lock" size={14} />
    Génération 100 % locale avec <code>crypto.getRandomValues()</code> — le mot de passe n'est jamais transmis ni stocké.
  </p>
</div>

<style>
  .pw-output {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px 24px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    background:
      radial-gradient(420px 120px at 20% 0%, var(--glow), transparent 70%),
      var(--panel);
  }

  .pw-value {
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    letter-spacing: 0.02em;
    word-break: break-all;
    line-height: 1.4;
    animation: pw-in 0.3s var(--ease);
  }

  @keyframes pw-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .pw-actions {
    display: flex;
    gap: 8px;
  }

  .pw-meter {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    font-size: 0.83rem;
    color: var(--muted);
  }

  .pw-segments {
    display: flex;
    gap: 5px;
    flex: 1;
    max-width: 260px;
  }

  .pw-segments span {
    height: 6px;
    flex: 1;
    border-radius: 999px;
    background: var(--panel-strong);
    transition: background 0.3s;
  }

  .pw-segments[data-level='1'] span:nth-child(1) {
    background: #ff5470;
  }
  .pw-segments[data-level='2'] span:nth-child(-n + 2) {
    background: #ffb454;
  }
  .pw-segments[data-level='3'] span:nth-child(-n + 3) {
    background: #a3e635;
  }
  .pw-segments[data-level='4'] span {
    background: #4ade9e;
  }

  .pw-meter-bits {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .pw-options {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .pw-options .field label {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .pw-options output {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .pw-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pw-note {
    color: #ff8296;
    font-size: 0.85rem;
  }

  .pw-privacy {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--faint);
  }

  .pw-privacy code {
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.75rem;
  }
</style>

<script>
  import { generatePassword, passwordStrength } from '../../lib/password.js';
  import { bindRangeFill, copyText, toast } from '../../lib/ui.js';

  const root = document.getElementById('tool-password');
  if (root) {
    const output = root.querySelector('[data-output]');
    const copyBtn = root.querySelector('[data-copy]');
    const regenBtn = root.querySelector('[data-regen]');
    const lengthRange = root.querySelector('[data-length]');
    const lenOut = root.querySelector('[data-len-out]');
    const segments = root.querySelector('[data-segments]');
    const strengthLabel = root.querySelector('[data-strength-label]');
    const strengthBits = root.querySelector('[data-strength-bits]');
    const note = root.querySelector('[data-note]');
    const opts = {
      upper: root.querySelector('[data-opt-upper]'),
      lower: root.querySelector('[data-opt-lower]'),
      digits: root.querySelector('[data-opt-digits]'),
      symbols: root.querySelector('[data-opt-symbols]'),
      noAmb: root.querySelector('[data-opt-noamb]'),
    };

    bindRangeFill(lengthRange);
    lengthRange.addEventListener('input', () => {
      lenOut.textContent = lengthRange.value;
      regenerate();
    });

    const getOptions = () => ({
      upper: opts.upper.checked,
      lower: opts.lower.checked,
      digits: opts.digits.checked,
      symbols: opts.symbols.checked,
      noAmbiguous: opts.noAmb.checked,
    });

    let current = '';

    function regenerate() {
      const length = Number(lengthRange.value);
      const options = getOptions();
      const strength = passwordStrength(length, options);
      const noneSelected = !options.upper && !options.lower && !options.digits && !options.symbols;

      note.hidden = !noneSelected;
      if (noneSelected) {
        output.textContent = '••••••••••••••••';
        current = '';
        segments.removeAttribute('data-level');
        strengthLabel.textContent = '—';
        strengthBits.textContent = '';
        copyBtn.disabled = true;
        regenBtn.disabled = true;
        return;
      }
      copyBtn.disabled = false;
      regenBtn.disabled = false;

      current = generatePassword(length, options, (arr) => crypto.getRandomValues(arr));
      output.textContent = current;
      // relance la micro-animation
      output.style.animation = 'none';
      void output.offsetWidth;
      output.style.animation = '';

      segments.dataset.level = String(strength.level);
      strengthLabel.textContent = strength.label;
      strengthBits.textContent = `≈ ${strength.bits} bits`;
    }

    Object.values(opts).forEach((el) => el.addEventListener('change', regenerate));
    regenBtn.addEventListener('click', regenerate);

    copyBtn.addEventListener('click', async () => {
      if (!current) return;
      const ok = await copyText(current);
      toast(ok ? 'Mot de passe copié dans le presse-papiers.' : 'Impossible de copier automatiquement — sélectionnez le texte manuellement.', ok ? 'success' : 'error');
    });

    regenerate();
  }
</script>
