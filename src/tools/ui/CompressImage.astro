---
import Icon from '../../components/Icon.astro';
---

<div class="ftool" id="tool-compress">
  <div class="ftool-options">
    <div class="preset-row" role="group" aria-label="Compression presets">
      <button type="button" class="preset" data-preset="45">Max savings</button>
      <button type="button" class="preset" data-preset="60">Email</button>
      <button type="button" class="preset" data-preset="75" aria-pressed="true">Website</button>
      <button type="button" class="preset" data-preset="90">High quality</button>
    </div>
    <div class="opt">
      <label for="ci-quality">Compression quality <output id="ci-out" data-quality-out>75 %</output></label>
      <input type="range" id="ci-quality" min="10" max="100" value="75" step="1" data-quality aria-describedby="ci-hint" />
      <p class="opt-hint" id="ci-hint">Lower quality means a lighter file. Around 75 %, the difference stays invisible.</p>
    </div>
  </div>

  <div data-notice hidden></div>

  <div class="dropzone" data-dropzone>
    <input type="file" data-file-input multiple hidden />
    <span class="dz-icon" aria-hidden="true"><Icon name="upload" size={24} /></span>
    <h3>Drag & drop your images here</h3>
    <p>or click to browse · JPG, PNG, WebP · up to 50 MB per file</p>
    <span class="btn btn-primary btn-sm dz-cta" aria-hidden="true">Choose images</span>
  </div>

  <div class="ftool-actions">
    <span class="ftool-count" data-count aria-live="polite"></span>
    <span class="ftool-actions-btns">
      <button type="button" class="btn btn-ghost btn-sm" data-clear-all hidden>Start over</button>
      <button type="button" class="btn btn-accent btn-sm" data-download-all hidden>Download all (ZIP)</button>
    </span>
  </div>

  <ul class="file-list" data-file-list role="list" aria-label="Images being compressed"></ul>

  <div class="batch-summary" data-summary hidden>
    <div class="stat"><div class="stat-value" data-sum-count>—</div><div class="stat-label">Files</div></div>
    <div class="stat"><div class="stat-value" data-sum-done>—</div><div class="stat-label">Done</div></div>
    <div class="stat"><div class="stat-value" data-sum-failed>—</div><div class="stat-label">Failed</div></div>
    <div class="stat"><div class="stat-value" data-sum-before>—</div><div class="stat-label">Before</div></div>
    <div class="stat"><div class="stat-value" data-sum-after>—</div><div class="stat-label">After</div></div>
    <div class="stat"><div class="stat-value accent" data-sum-saved>—</div><div class="stat-label">Saved</div></div>
  </div>

  <!-- Before/after comparator (single finished file) -->
  <div class="compare" data-compare hidden>
    <div class="compare-head">
      <h3>Before / after comparison</h3>
      <label class="compare-label">
        Show result
        <input type="range" min="0" max="100" value="50" data-compare-range aria-label="Reveal the compressed image" />
      </label>
    </div>
    <div class="compare-stage" data-compare-stage>
      <img data-compare-before alt="Original image before compression" />
      <div class="compare-after" data-compare-after>
        <img data-compare-afterimg alt="Compressed image after processing" />
      </div>
      <span class="compare-tag tag-before">Before</span>
      <span class="compare-tag tag-after">After</span>
    </div>
  </div>

  <div class="handoff-chip" data-handoff hidden>
    <Icon name="spark" size={16} />
    <span>Continue with <strong data-handoff-name></strong> from the previous tool?</span>
    <button type="button" class="btn btn-sm btn-ghost" data-handoff-use>Use this file</button>
    <button type="button" class="icon-btn" data-handoff-dismiss aria-label="Dismiss">✕</button>
  </div>
</div>

<style>
  .ftool-options {
    margin-bottom: 22px;
  }
  .opt label {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .opt output {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .opt-hint {
    font-size: 0.78rem;
    color: var(--faint);
    margin-top: 8px;
  }
  .ftool-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .ftool-count {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }
  .ftool-actions-btns {
    display: flex;
    gap: 10px;
  }

  .compare {
    margin-top: 22px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    animation: item-in 0.35s var(--ease) both;
  }

  .compare-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .compare-head h3 {
    font-size: 0.95rem;
  }

  .compare-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .compare-label input {
    width: 160px;
  }

  .compare-stage {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--panel-strong);
    line-height: 0;
  }

  .compare-stage img {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
  }

  .compare-after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 50%);
  }

  .compare-tag {
    position: absolute;
    top: 10px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(10, 10, 14, 0.72);
    color: #fff;
    line-height: 1.4;
  }

  .tag-before {
    left: 10px;
  }
  .tag-after {
    right: 10px;
    background: var(--accent-grad);
    color: #241203;
  }
</style>

<script>
  import { mountFileTool } from '../../lib/fileui.js';
  import { decodeImage, renderToBlob, renameWithExt } from '../../lib/image.js';
  import { bindRangeFill, toast } from '../../lib/ui.js';
  import { saveHandoff, mountHandoffChip } from '../../lib/handoff.js';

  const root = document.getElementById('tool-compress');
  if (root) {
    const quality = root.querySelector('[data-quality]');
    const out = root.querySelector('[data-quality-out]');
    const compare = root.querySelector('[data-compare]');
    const range = root.querySelector('[data-compare-range]');
    const afterWrap = root.querySelector('[data-compare-after]');
    bindRangeFill(quality);
    const syncOut = () => (out.textContent = `${quality.value} %`);
    quality.addEventListener('input', syncOut);
    syncOut();

    // Presets
    root.querySelectorAll('.preset').forEach((p) => {
      p.addEventListener('click', () => {
        quality.value = p.dataset.preset;
        root.querySelectorAll('.preset').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        p.setAttribute('aria-pressed', 'true');
        bindRangeFill(quality);
        syncOut();
        quality.dispatchEvent(new Event('change'));
      });
    });
    quality.addEventListener('input', () => root.querySelectorAll('.preset').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.preset === quality.value))));

    const extFor = (type) => (type === 'image/png' ? 'png' : type === 'image/webp' ? 'webp' : 'jpg');

    const api = mountFileTool(root, {
      acceptTypes: ['image/jpeg', 'image/png', 'image/webp'],
      acceptExts: ['.jpg', '.jpeg', '.png', '.webp'],
      summary: true,
      process: async (item) => {
        const img = await decodeImage(item.file);
        try {
          const format = item.file.type === 'image/png' ? 'image/png' : item.file.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
          const blob = await renderToBlob(img.source, {
            width: img.width,
            height: img.height,
            format,
            quality: Number(quality.value) / 100,
          });
          const name = renameWithExt(item.file.name, extFor(format));
          if (format === 'image/png' && blob.size >= item.file.size) item._pngWarn = true;
          return { blob, name };
        } finally {
          img.close();
        }
      },
      onListChange: (items) => {
        const done = items.filter((i) => i.status === 'done' && i.result?.blob);
        if (done.length === 1) {
          const item = done[0];
          compare.hidden = false;
          setSrc(root.querySelector('[data-compare-before]'), item.file);
          setSrc(root.querySelector('[data-compare-afterimg]'), item.result.blob);
          if (item._pngWarn) {
            toast('PNG is lossless — for big savings, convert to WebP instead.', 'info', 6000);
            item._pngWarn = false;
          }
          saveHandoff({ fromTool: 'image-compressor', name: item.result.name, type: item.result.blob.type, blob: item.result.blob });
        } else {
          compare.hidden = true;
        }
      },
    });

    function setSrc(img, blobOrFile) {
      if (img._url) URL.revokeObjectURL(img._url);
      img._url = URL.createObjectURL(blobOrFile);
      img.src = img._url;
    }

    const syncCompare = () => {
      afterWrap.style.clipPath = `inset(0 0 0 ${range.value}%)`;
    };
    range.addEventListener('input', syncCompare);
    bindRangeFill(range);
    syncCompare();

    quality.addEventListener('change', async () => {
      if (!api.items.length) return;
      for (const item of api.items) await api.processItem(item);
      toast(`Re-compressed at ${quality.value} %.`, 'success');
    });

    mountHandoffChip(root, api, 'image/');
  }
</script>
