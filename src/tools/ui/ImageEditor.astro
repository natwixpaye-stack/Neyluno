---
import Icon from '../../components/Icon.astro';
---

<div class="ftool ie" id="tool-image-editor">
  <div class="dropzone" data-dropzone>
    <input type="file" data-file-input hidden />
    <span class="dz-icon" aria-hidden="true"><Icon name="edit" size={24} /></span>
    <h3>Drop an image to edit</h3>
    <p>or click to browse · JPG, PNG, WebP · everything stays on your device</p>
    <span class="btn btn-primary btn-sm dz-cta" aria-hidden="true">Choose an image</span>
  </div>

  <div class="ie-work" data-work hidden>
    <div class="ie-stage">
      <canvas data-canvas aria-label="Edited image preview"></canvas>
    </div>
    <div class="ie-side">
      <div class="ie-group" role="group" aria-label="Transform">
        <button type="button" class="btn btn-ghost btn-sm" data-rot="-90">↺ 90°</button>
        <button type="button" class="btn btn-ghost btn-sm" data-rot="90">↻ 90°</button>
        <button type="button" class="btn btn-ghost btn-sm" data-flip="h">Flip ↔</button>
        <button type="button" class="btn btn-ghost btn-sm" data-flip="v">Flip ↕</button>
      </div>
      <div class="ie-group ie-filters">
        <label>Brightness <output data-out="brightness">100 %</output></label>
        <input type="range" min="20" max="200" value="100" data-f="brightness" />
        <label>Contrast <output data-out="contrast">100 %</output></label>
        <input type="range" min="20" max="200" value="100" data-f="contrast" />
        <label>Saturation <output data-out="saturate">100 %</output></label>
        <input type="range" min="0" max="200" value="100" data-f="saturate" />
        <label>Grayscale <output data-out="grayscale">0 %</output></label>
        <input type="range" min="0" max="100" value="0" data-f="grayscale" />
        <label>Blur <output data-out="blur">0 px</output></label>
        <input type="range" min="0" max="10" value="0" step="0.5" data-f="blur" />
        <p class="opt-hint" data-filter-note hidden>Your browser doesn’t support live filters — transforms still work.</p>
      </div>
      <div class="ie-group ie-history">
        <button type="button" class="btn btn-ghost btn-sm" data-undo disabled>Undo</button>
        <button type="button" class="btn btn-ghost btn-sm" data-redo disabled>Redo</button>
        <button type="button" class="btn btn-ghost btn-sm" data-reset>Reset</button>
      </div>
      <div class="ie-group ie-export">
        <select class="select" data-format aria-label="Export format">
          <option value="image/png">PNG</option>
          <option value="image/jpeg">JPG</option>
          <option value="image/webp" selected>WebP</option>
        </select>
        <button type="button" class="btn btn-primary btn-sm" data-download>Download</button>
        <button type="button" class="btn btn-ghost btn-sm" data-new>New image</button>
      </div>
    </div>
  </div>
  <div data-notice hidden></div>
</div>

<style>
  .ie-work { display: grid; grid-template-columns: 1fr 260px; gap: 18px; margin-top: 18px; }
  @media (max-width: 820px) { .ie-work { grid-template-columns: 1fr; } }
  .ie-stage { border: 1px solid var(--border); border-radius: var(--radius); background: var(--panel); display: grid; place-items: center; padding: 12px; min-height: 260px; }
  .ie-stage canvas { max-width: 100%; max-height: 62vh; border-radius: 8px; background: repeating-conic-gradient(color-mix(in srgb, var(--panel-strong) 60%, transparent) 0% 25%, transparent 0% 50%) 0 0 / 14px 14px; }
  .ie-side { display: flex; flex-direction: column; gap: 16px; }
  .ie-group { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .ie-filters { flex-direction: column; align-items: stretch; gap: 6px; }
  .ie-filters label { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-top: 6px; }
  .ie-filters output { color: var(--accent); }
  .ie-export { flex-direction: column; align-items: stretch; }
</style>

<script>
  import { decodeImage } from '../../lib/image.js';
  import { downloadBlob, toast } from '../../lib/ui.js';
  import { validateFile } from '../../lib/files.js';

  const root = document.getElementById('tool-image-editor');
  if (root) {
    const dz = root.querySelector('[data-dropzone]');
    const input = root.querySelector('[data-file-input]');
    const work = root.querySelector('[data-work]');
    const canvas = root.querySelector('[data-canvas]');
    const notice = root.querySelector('[data-notice]');
    const undoBtn = root.querySelector('[data-undo]');
    const redoBtn = root.querySelector('[data-redo]');

    let img = null; // decoded source
    let fileName = 'image';
    let state = null; // current adjustments
    let past = [];
    let future = [];

    const DEFAULTS = { rot: 0, flipH: false, flipV: false, brightness: 100, contrast: 100, saturate: 100, grayscale: 0, blur: 0 };
    const filtersSupported = 'filter' in canvas.getContext('2d');
    if (!filtersSupported) root.querySelector('[data-filter-note]').hidden = false;

    function snapshot() {
      past.push({ ...state });
      if (past.length > 50) past.shift();
      future = [];
      syncHistory();
    }
    function syncHistory() {
      undoBtn.disabled = past.length === 0;
      redoBtn.disabled = future.length === 0;
    }

    function draw() {
      if (!img) return;
      const swap = state.rot % 180 !== 0;
      const w = swap ? img.height : img.width;
      const h = swap ? img.width : img.height;
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.save();
      ctx.clearRect(0, 0, w, h);
      if (filtersSupported) {
        ctx.filter = `brightness(${state.brightness}%) contrast(${state.contrast}%) saturate(${state.saturate}%) grayscale(${state.grayscale}%) blur(${state.blur}px)`;
      }
      ctx.translate(w / 2, h / 2);
      ctx.rotate((state.rot * Math.PI) / 180);
      ctx.scale(state.flipH ? -1 : 1, state.flipV ? -1 : 1);
      ctx.drawImage(img.source, -img.width / 2, -img.height / 2);
      ctx.restore();
    }

    function bindUI() {
      root.querySelectorAll('[data-f]').forEach((r) => {
        r.addEventListener('input', () => {
          state[r.dataset.f] = Number(r.value);
          root.querySelector(`[data-out="${r.dataset.f}"]`).textContent = r.dataset.f === 'blur' ? `${r.value} px` : `${r.value} %`;
          draw();
        });
        r.addEventListener('change', snapshot);
      });
      root.querySelectorAll('[data-rot]').forEach((b) =>
        b.addEventListener('click', () => {
          snapshot();
          state.rot = (state.rot + Number(b.dataset.rot) + 360) % 360;
          draw();
        })
      );
      root.querySelectorAll('[data-flip]').forEach((b) =>
        b.addEventListener('click', () => {
          snapshot();
          if (b.dataset.flip === 'h') state.flipH = !state.flipH;
          else state.flipV = !state.flipV;
          draw();
        })
      );
      undoBtn.addEventListener('click', () => {
        if (!past.length) return;
        future.push({ ...state });
        state = past.pop();
        reflect();
        syncHistory();
      });
      redoBtn.addEventListener('click', () => {
        if (!future.length) return;
        past.push({ ...state });
        state = future.pop();
        reflect();
        syncHistory();
      });
      root.querySelector('[data-reset]').addEventListener('click', () => {
        snapshot();
        state = { ...DEFAULTS };
        reflect();
      });
      root.querySelector('[data-download]').addEventListener('click', async () => {
        const format = root.querySelector('[data-format]').value;
        if (format === 'image/jpeg') {
          // flatten transparency for JPG
          const tmp = document.createElement('canvas');
          tmp.width = canvas.width;
          tmp.height = canvas.height;
          const tctx = tmp.getContext('2d');
          tctx.fillStyle = '#ffffff';
          tctx.fillRect(0, 0, tmp.width, tmp.height);
          tctx.drawImage(canvas, 0, 0);
          tmp.toBlob((b) => b && downloadBlob(b, outName('jpg')), format, 0.92);
        } else {
          canvas.toBlob((b) => b && downloadBlob(b, outName(format === 'image/png' ? 'png' : 'webp')), format, 0.92);
        }
        toast('Export ready.', 'success');
      });
      root.querySelector('[data-new]').addEventListener('click', resetAll);
    }

    function outName(ext) {
      const base = fileName.replace(/\.[^.]+$/, '') || 'image';
      return `${base}-edited.${ext}`;
    }

    function reflect() {
      root.querySelectorAll('[data-f]').forEach((r) => {
        r.value = state[r.dataset.f];
        r.dispatchEvent(new Event('input'));
      });
      // inputs event already snapshots on change; avoid double snapshot here
      draw();
    }

    function resetAll() {
      img?.close?.();
      img = null;
      past = [];
      future = [];
      state = { ...DEFAULTS };
      work.hidden = true;
      dz.hidden = false;
      syncHistory();
    }

    async function load(file) {
      const check = validateFile(file, {
        acceptTypes: ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/bmp'],
        acceptExts: ['.jpg', '.jpeg', '.png', '.webp', '.gif', '.bmp'],
      });
      if (!check.ok) {
        notice.hidden = false;
        notice.innerHTML = `<div class="notice notice-error" role="alert">${check.error}</div>`;
        return;
      }
      notice.hidden = true;
      img?.close?.();
      img = await decodeImage(file);
      fileName = file.name;
      past = [];
      future = [];
      state = { ...DEFAULTS };
      reflect();
      syncHistory();
      dz.hidden = true;
      work.hidden = false;
    }

    dz.addEventListener('click', () => input.click());
    dz.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        input.click();
      }
    });
    ['dragenter', 'dragover'].forEach((evt) => dz.addEventListener(evt, (e) => { e.preventDefault(); dz.classList.add('is-dragover'); }));
    ['dragleave', 'drop'].forEach((evt) => dz.addEventListener(evt, (e) => { e.preventDefault(); dz.classList.remove('is-dragover'); }));
    dz.addEventListener('drop', (e) => load(e.dataTransfer.files[0]));
    input.addEventListener('change', () => {
      if (input.files[0]) load(input.files[0]);
      input.value = '';
    });
    bindUI();
  }
</script>
