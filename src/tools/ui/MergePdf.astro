---
import Icon from '../../components/Icon.astro';
---

<div class="ftool" id="tool-merge-pdf">
  <div data-notice hidden></div>

  <div class="dropzone" data-dropzone>
    <input type="file" data-file-input multiple hidden />
    <span class="dz-icon" aria-hidden="true"><Icon name="upload" size={24} /></span>
    <h3>Drag & drop your PDF files here</h3>
    <p>or click to browse · PDF only · up to 50 MB per file</p>
    <span class="btn btn-primary btn-sm dz-cta" aria-hidden="true">Choose PDF files</span>
  </div>

  <p class="mp-hint">Reorder with the ↑↓ arrows — the final document follows the list order.</p>

  <div class="ftool-actions">
    <span class="ftool-count" data-count aria-live="polite"></span>
    <span class="ftool-actions-btns">
      <button type="button" class="btn btn-ghost btn-sm" data-clear-all hidden>Start over</button>
      <button type="button" class="btn btn-accent btn-sm" data-merge hidden>Merge PDFs</button>
    </span>
  </div>

  <ul class="file-list" data-file-list role="list" aria-label="PDF files to merge"></ul>
</div>

<style>
  .mp-hint {
    font-size: 0.78rem;
    color: var(--faint);
    margin-top: 14px;
  }
  .ftool-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .ftool-count {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }
  .ftool-actions-btns {
    display: flex;
    gap: 10px;
  }
</style>

<script>
  import { mountFileTool } from '../../lib/fileui.js';
  import { toast, downloadBlob } from '../../lib/ui.js';

  const root = document.getElementById('tool-merge-pdf');
  if (root) {
    const mergeBtn = root.querySelector('[data-merge]');
    const pageCounts = new Map(); // id → { pages } | { error }

    const api = mountFileTool(root, {
      acceptTypes: ['application/pdf'],
      acceptExts: ['.pdf'],
      autoProcess: false,
      reorderable: true,
      withThumb: false,
      itemMeta: (item) => {
        const info = pageCounts.get(item.id);
        if (!info) return '· analyzing…';
        if (info.error) return '· ⚠ protected or unreadable';
        return `· ${info.pages} page${info.pages > 1 ? 's' : ''}`;
      },
      onListChange: (items) => {
        mergeBtn.hidden = items.length === 0;
        for (const item of items) {
          if (!pageCounts.has(item.id)) countPages(item);
        }
      },
    });

    async function countPages(item) {
      try {
        const { PDFDocument } = await import('pdf-lib');
        const doc = await PDFDocument.load(await item.file.arrayBuffer(), {
          ignoreEncryption: true,
          updateMetadata: false,
        });
        if (doc.isEncrypted) {
          pageCounts.set(item.id, { error: 'encrypted' });
        } else {
          pageCounts.set(item.id, { pages: doc.getPageCount() });
        }
      } catch {
        pageCounts.set(item.id, { error: 'invalid' });
      }
      api.refreshMeta(item);
    }

    mergeBtn.addEventListener('click', async () => {
      const items = api.items;
      if (items.length < 2) {
        api.showNotice('Add at least two PDFs to start a merge.', 'error');
        return;
      }
      const bad = items.filter((i) => pageCounts.get(i.id)?.error);
      if (bad.length) {
        api.showNotice(
          `Cannot merge: ${bad.map((i) => `“${i.file.name}”`).join(', ')} is password-protected or unreadable. Remove it and try again.`,
          'error'
        );
        return;
      }
      const stillAnalyzing = items.some((i) => !pageCounts.has(i.id));
      if (stillAnalyzing) {
        api.showNotice('Still analyzing files — try again in a moment.', 'info');
        return;
      }

      mergeBtn.disabled = true;
      const label = mergeBtn.textContent;
      mergeBtn.textContent = 'Merging…';
      try {
        const { PDFDocument } = await import('pdf-lib');
        const out = await PDFDocument.create();
        for (const item of items) {
          const src = await PDFDocument.load(await item.file.arrayBuffer(), {
            ignoreEncryption: true,
            updateMetadata: false,
          });
          const pages = await out.copyPages(src, src.getPageIndices());
          pages.forEach((p) => out.addPage(p));
        }
        const bytes = await out.save();
        downloadBlob(new Blob([bytes], { type: 'application/pdf' }), 'quicktools-merged.pdf');
        toast(`Merged ${items.length} PDFs into one document.`, 'success');
        api.showNotice('');
      } catch (err) {
        api.showNotice(err?.message || 'The merge failed. Make sure your files are valid PDFs.', 'error');
      } finally {
        mergeBtn.disabled = false;
        mergeBtn.textContent = label;
      }
    });
  }
</script>
