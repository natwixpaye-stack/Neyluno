---
import Icon from '../../components/Icon.astro';
---

<div class="ftool" id="tool-favicon">
  <div data-notice hidden></div>

  <div class="dropzone" data-dropzone>
    <input type="file" data-file-input hidden />
    <span class="dz-icon" aria-hidden="true"><Icon name="upload" size={24} /></span>
    <h3>Drag & drop your logo here</h3>
    <p>or click to browse · square PNG with transparency works best · up to 50 MB</p>
    <span class="btn btn-primary btn-sm dz-cta" aria-hidden="true">Choose a logo</span>
  </div>

  <div class="fav-panel" data-fav-panel hidden>
    <div class="fav-preview">
      <img data-fav-preview alt="Your logo preview" />
      <div class="fav-info">
        <p class="fav-name" data-fav-name></p>
        <p class="fav-dims" data-fav-dims></p>
      </div>
    </div>

    <fieldset class="fav-sizes">
      <legend>Sizes to include</legend>
      <label class="pill-check"><input type="checkbox" checked data-size="16" /><span class="dot" aria-hidden="true"></span>16 px — browsers</label>
      <label class="pill-check"><input type="checkbox" checked data-size="32" /><span class="dot" aria-hidden="true"></span>32 px — browsers</label>
      <label class="pill-check"><input type="checkbox" checked data-size="48" /><span class="dot" aria-hidden="true"></span>48 px — browsers</label>
      <label class="pill-check"><input type="checkbox" checked data-size="180" /><span class="dot" aria-hidden="true"></span>180 px — Apple touch</label>
      <label class="pill-check"><input type="checkbox" checked data-size="192" /><span class="dot" aria-hidden="true"></span>192 px — Android</label>
      <label class="pill-check"><input type="checkbox" checked data-size="512" /><span class="dot" aria-hidden="true"></span>512 px — PWA</label>
    </fieldset>

    <div class="crop-actions">
      <button type="button" class="btn btn-ghost btn-sm" data-fav-reset>Start over</button>
      <button type="button" class="btn btn-accent btn-sm" data-fav-go>Generate the kit</button>
    </div>

    <div class="fav-results" data-fav-results hidden>
      <h3>Your favicon kit</h3>
      <div class="fav-icons" data-fav-icons role="list" aria-label="Generated icons"></div>
      <div class="crop-actions">
        <button type="button" class="btn btn-primary btn-sm" data-fav-ico>Download favicon.ico</button>
        <button type="button" class="btn btn-ghost btn-sm" data-fav-zip>Download all (ZIP)</button>
        <button type="button" class="btn btn-ghost btn-sm" data-fav-html>Copy HTML snippet</button>
      </div>
      <details class="fav-snippet-details">
        <summary>Show the HTML snippet</summary>
        <pre class="fav-snippet" data-fav-snippet></pre>
      </details>
    </div>
  </div>
</div>

<style>
  .fav-panel {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fav-preview {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .fav-preview img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    border-radius: 12px;
    background:
      repeating-conic-gradient(color-mix(in srgb, var(--panel-strong) 60%, transparent) 0% 25%, transparent 0% 50%)
      0 0 / 16px 16px;
  }

  .fav-name {
    font-weight: 600;
    font-size: 0.92rem;
    word-break: break-all;
  }

  .fav-dims {
    color: var(--muted);
    font-size: 0.83rem;
    margin-top: 2px;
  }

  .fav-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    border: none;
    padding: 0;
  }

  .fav-sizes legend {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
    padding: 0;
  }

  .crop-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
  }

  .fav-results {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fav-results h3 {
    font-size: 1rem;
  }

  .fav-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .fav-icon-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .fav-icon-slot img {
    border-radius: 8px;
    background:
      repeating-conic-gradient(color-mix(in srgb, var(--panel-strong) 60%, transparent) 0% 25%, transparent 0% 50%)
      0 0 / 12px 12px;
  }

  .fav-icon-slot span {
    font-size: 0.72rem;
    color: var(--faint);
  }

  .fav-snippet-details summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }

  .fav-snippet {
    margin-top: 10px;
    padding: 14px;
    border-radius: 10px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    overflow-x: auto;
    white-space: pre;
  }
</style>

<script>
  import { decodeImage } from '../../lib/image.js';
  import { toast, downloadBlob, copyText } from '../../lib/ui.js';
  import { validateFile, MAX_FILE_BYTES } from '../../lib/files.js';

  const root = document.getElementById('tool-favicon');
  if (root) {
    const dz = root.querySelector('[data-dropzone]');
    const input = root.querySelector('[data-file-input]');
    const panel = root.querySelector('[data-fav-panel]');
    const preview = root.querySelector('[data-fav-preview]');
    const nameEl = root.querySelector('[data-fav-name]');
    const dimsEl = root.querySelector('[data-fav-dims]');
    const goBtn = root.querySelector('[data-fav-go]');
    const results = root.querySelector('[data-fav-results]');
    const iconsEl = root.querySelector('[data-fav-icons]');
    const snippetEl = root.querySelector('[data-fav-snippet]');

    let file = null;
    let src = null;
    let outputs = []; // {size, blob}

    dz.setAttribute('role', 'button');
    dz.setAttribute('tabindex', '0');
    dz.addEventListener('click', () => input.click());
    dz.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        input.click();
      }
    });
    dz.addEventListener('drop', (e) => {
      e.preventDefault();
      if (e.dataTransfer?.files?.length) loadFile(e.dataTransfer.files[0]);
    });
    input.addEventListener('change', () => {
      if (input.files?.length) loadFile(input.files[0]);
      input.value = '';
    });

    async function loadFile(f) {
      const check = validateFile(f, { acceptTypes: ['image/jpeg', 'image/png', 'image/webp', 'image/svg+xml'], acceptExts: ['.jpg', '.jpeg', '.png', '.webp', '.svg'], maxBytes: MAX_FILE_BYTES });
      if (!check.ok) {
        toast(check.error, 'error');
        return;
      }
      try {
        src?.close();
        src = await decodeImage(f);
      } catch (err) {
        toast(err.message || 'This image could not be read.', 'error');
        return;
      }
      file = f;
      outputs = [];
      results.hidden = true;
      preview.src = URL.createObjectURL(f);
      nameEl.textContent = f.name;
      dimsEl.textContent = `${src.width} × ${src.height} px${src.width === src.height ? '' : ' — not square: it will be centered and padded'}`;
      dz.hidden = true;
      panel.hidden = false;
    }

    function renderSize(size) {
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      const s = Math.min(size / src.width, size / src.height);
      const w = src.width * s;
      const h = src.height * s;
      ctx.drawImage(src.source, (size - w) / 2, (size - h) / 2, w, h);
      return canvas;
    }

    goBtn.addEventListener('click', async () => {
      const sizes = [...root.querySelectorAll('[data-size]:checked')].map((c) => Number(c.dataset.size));
      if (!sizes.length) {
        toast('Select at least one size.', 'error');
        return;
      }
      if (!src) return;
      goBtn.disabled = true;
      goBtn.textContent = 'Generating…';
      try {
        outputs = [];
        iconsEl.innerHTML = '';
        for (const size of sizes) {
          const canvas = renderSize(size);
          const blob = await new Promise((resolve, reject) => {
            canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Icon rendering failed.'))), 'image/png');
          });
          outputs.push({ size, blob });
          const slot = document.createElement('div');
          slot.className = 'fav-icon-slot';
          slot.setAttribute('role', 'listitem');
          const img = document.createElement('img');
          img.alt = `Favicon ${size} × ${size}`;
          const shown = Math.min(size, 64);
          img.width = shown;
          img.height = shown;
          img.src = URL.createObjectURL(blob);
          const label = document.createElement('span');
          label.textContent = `${size} × ${size}`;
          slot.append(img, label);
          iconsEl.appendChild(slot);
        }
        buildSnippet();
        results.hidden = false;
        results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err) {
        toast(err.message || 'Generation failed.', 'error');
      } finally {
        goBtn.disabled = false;
        goBtn.textContent = 'Generate the kit';
      }
    });

    function buildSnippet() {
      const has = (s) => outputs.some((o) => o.size === s);
      const lines = [];
      if (outputs.some((o) => o.size <= 48)) lines.push('<link rel="icon" href="/favicon.ico">');
      if (has(180)) lines.push('<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">');
      if (has(192)) lines.push('<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">');
      if (has(512)) lines.push('<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">');
      snippetEl.textContent = lines.join('\n');
    }

    /** Build a real multi-size ICO from PNG frames. */
    async function buildIco() {
      const frames = outputs.filter((o) => o.size <= 48);
      const list = frames.length ? frames : outputs.slice(0, 1);
      const datas = await Promise.all(list.map((f) => f.blob.arrayBuffer()));
      const headerSize = 6 + 16 * list.length;
      let offset = headerSize;
      const total = datas.reduce((s, d) => s + d.byteLength, 0);
      const buf = new Uint8Array(headerSize + total);
      const view = new DataView(buf.buffer);
      view.setUint16(0, 0, true); // reserved
      view.setUint16(2, 1, true); // type: icon
      view.setUint16(4, list.length, true);
      list.forEach((f, i) => {
        const base = 6 + i * 16;
        view.setUint8(base, f.size >= 256 ? 0 : f.size);
        view.setUint8(base + 1, f.size >= 256 ? 0 : f.size);
        view.setUint8(base + 2, 0); // palette
        view.setUint8(base + 3, 0); // reserved
        view.setUint16(base + 4, 1, true); // planes
        view.setUint16(base + 6, 32, true); // bpp
        view.setUint32(base + 8, datas[i].byteLength, true);
        view.setUint32(base + 12, offset, true);
        buf.set(new Uint8Array(datas[i]), offset);
        offset += datas[i].byteLength;
      });
      return new Blob([buf], { type: 'image/x-icon' });
    }

    root.querySelector('[data-fav-ico]').addEventListener('click', async () => {
      try {
        const ico = await buildIco();
        downloadBlob(ico, 'favicon.ico');
      } catch {
        toast('Could not build the ICO file.', 'error');
      }
    });

    root.querySelector('[data-fav-zip]').addEventListener('click', async () => {
      try {
        const { zipSync } = await import('fflate');
        const entries = {};
        for (const o of outputs) {
          const name =
            o.size === 180 ? 'apple-touch-icon.png' :
            o.size === 192 ? 'android-chrome-192x192.png' :
            o.size === 512 ? 'android-chrome-512x512.png' :
            `favicon-${o.size}x${o.size}.png`;
          entries[name] = new Uint8Array(await o.blob.arrayBuffer());
        }
        if (outputs.some((o) => o.size <= 48)) {
          entries['favicon.ico'] = new Uint8Array(await (await buildIco()).arrayBuffer());
        }
        downloadBlob(new Blob([zipSync(entries)], { type: 'application/zip' }), 'favicon-kit.zip');
      } catch {
        toast('Creating the ZIP failed — download icons one by one from the previews.', 'error');
      }
    });

    root.querySelector('[data-fav-html]').addEventListener('click', async () => {
      const ok = await copyText(snippetEl.textContent);
      toast(ok ? 'HTML snippet copied.' : 'Could not copy — select the text manually.', ok ? 'success' : 'error');
    });

    root.querySelector('[data-fav-reset]').addEventListener('click', () => {
      src?.close();
      src = null;
      file = null;
      outputs = [];
      panel.hidden = true;
      results.hidden = true;
      dz.hidden = false;
    });
  }
</script>
