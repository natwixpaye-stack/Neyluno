---
import Icon from '../../components/Icon.astro';
---

<div class="ftool" id="tool-compress-pdf">
  <div data-notice hidden></div>

  <div class="dropzone" data-dropzone>
    <input type="file" data-file-input hidden />
    <span class="dz-icon" aria-hidden="true"><Icon name="upload" size={24} /></span>
    <h3>Drag & drop your PDF here</h3>
    <p>or click to browse · PDF only · up to 50 MB</p>
    <span class="btn btn-primary btn-sm dz-cta" aria-hidden="true">Choose a PDF</span>
  </div>

  <div class="cp-panel" data-cp-panel hidden>
    <div class="sp-file">
      <span class="sp-file-icon" aria-hidden="true"><Icon name="pdf" size={20} /></span>
      <div>
        <p class="sp-file-name" data-cp-name></p>
        <p class="sp-file-meta" data-cp-meta></p>
      </div>
    </div>

    <div class="crop-actions">
      <button type="button" class="btn btn-ghost btn-sm" data-cp-reset>Start over</button>
      <button type="button" class="btn btn-accent btn-sm" data-cp-go>Compress</button>
    </div>

    <div class="cp-result" data-cp-result hidden>
      <div class="batch-summary" style="margin-top:0">
        <div class="stat"><div class="stat-value" data-cp-before>—</div><div class="stat-label">Before</div></div>
        <div class="stat"><div class="stat-value" data-cp-after>—</div><div class="stat-label">After</div></div>
        <div class="stat"><div class="stat-value accent" data-cp-saved>—</div><div class="stat-label">Saved</div></div>
      </div>
      <p class="cp-verdict" data-cp-verdict></p>
      <div class="crop-actions">
        <button type="button" class="btn btn-primary btn-sm" data-cp-download hidden>Download compressed PDF</button>
      </div>
    </div>
  </div>
</div>

<style>
  .cp-panel {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sp-file {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .sp-file-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: #ff6e59;
    background: color-mix(in srgb, #ff6e59 12%, transparent);
    flex: none;
  }

  .sp-file-name {
    font-weight: 600;
    font-size: 0.92rem;
    word-break: break-all;
  }

  .sp-file-meta {
    color: var(--muted);
    font-size: 0.82rem;
    margin-top: 2px;
  }

  .crop-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .cp-result {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .cp-verdict {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>

<script>
  import { toast, downloadBlob } from '../../lib/ui.js';
  import { validateFile, MAX_FILE_BYTES } from '../../lib/files.js';
  import { formatBytes } from '../../lib/format.js';

  const root = document.getElementById('tool-compress-pdf');
  if (root) {
    const dz = root.querySelector('[data-dropzone]');
    const input = root.querySelector('[data-file-input]');
    const panel = root.querySelector('[data-cp-panel]');
    const nameEl = root.querySelector('[data-cp-name]');
    const metaEl = root.querySelector('[data-cp-meta]');
    const goBtn = root.querySelector('[data-cp-go]');
    const result = root.querySelector('[data-cp-result]');
    const verdict = root.querySelector('[data-cp-verdict]');
    const downloadBtn = root.querySelector('[data-cp-download]');

    let file = null;
    let pageCount = 0;
    let outBlob = null;

    dz.setAttribute('role', 'button');
    dz.setAttribute('tabindex', '0');
    dz.addEventListener('click', () => input.click());
    dz.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        input.click();
      }
    });
    dz.addEventListener('drop', (e) => {
      e.preventDefault();
      if (e.dataTransfer?.files?.length) loadFile(e.dataTransfer.files[0]);
    });
    input.addEventListener('change', () => {
      if (input.files?.length) loadFile(input.files[0]);
      input.value = '';
    });

    async function loadFile(f) {
      const check = validateFile(f, { acceptTypes: ['application/pdf'], acceptExts: ['.pdf'], maxBytes: MAX_FILE_BYTES });
      if (!check.ok) {
        toast(check.error, 'error');
        return;
      }
      try {
        const { PDFDocument } = await import('pdf-lib');
        const doc = await PDFDocument.load(await f.arrayBuffer(), { ignoreEncryption: true, updateMetadata: false });
        if (doc.isEncrypted) throw new Error('protected');
        pageCount = doc.getPageCount();
      } catch (err) {
        toast(
          err?.message === 'protected'
            ? 'This PDF is password-protected and cannot be compressed.'
            : 'This PDF could not be read — it may be corrupted.',
          'error'
        );
        return;
      }
      file = f;
      outBlob = null;
      result.hidden = true;
      nameEl.textContent = f.name;
      metaEl.textContent = `${pageCount} page${pageCount > 1 ? 's' : ''} · ${formatBytes(f.size)}`;
      dz.hidden = true;
      panel.hidden = false;
    }

    root.querySelector('[data-cp-reset]').addEventListener('click', () => {
      file = null;
      panel.hidden = true;
      dz.hidden = false;
    });

    goBtn.addEventListener('click', async () => {
      if (!file) return;
      goBtn.disabled = true;
      const label = goBtn.textContent;
      goBtn.textContent = 'Compressing…';
      try {
        const { PDFDocument } = await import('pdf-lib');
        const doc = await PDFDocument.load(await file.arrayBuffer(), {
          ignoreEncryption: true,
          updateMetadata: false,
        });
        // Strip editable metadata — it bloats files and is rarely needed
        doc.setTitle('');
        doc.setAuthor('');
        doc.setSubject('');
        doc.setKeywords([]);
        doc.setProducer('QuickTools');
        doc.setCreator('QuickTools');

        const bytes = await doc.save({ useObjectStreams: true });
        const before = file.size;
        const after = bytes.byteLength;

        root.querySelector('[data-cp-before]').textContent = formatBytes(before);
        root.querySelector('[data-cp-after]').textContent = formatBytes(after);
        result.hidden = false;

        const base = file.name.replace(/\.pdf$/i, '');
        if (after < before) {
          const savedPct = Math.round((1 - after / before) * 100);
          root.querySelector('[data-cp-saved]').textContent = `−${savedPct} %`;
          verdict.textContent = `Rebuilt with optimized object streams and stripped metadata. ${formatBytes(before - after)} recovered.`;
          outBlob = new Blob([bytes], { type: 'application/pdf' });
          downloadBtn.hidden = false;
          downloadBtn.onclick = () => downloadBlob(outBlob, `${base}-compressed.pdf`);
        } else {
          // Honest mode: never fake a gain
          root.querySelector('[data-cp-saved]').textContent = '0 %';
          verdict.textContent =
            'This file is already optimized — rebuilding it gains nothing, so there is nothing to download. Your original is the best version.';
          downloadBtn.hidden = true;
        }
      } catch {
        toast('This PDF could not be processed. It may be corrupted or protected.', 'error');
      } finally {
        goBtn.disabled = false;
        goBtn.textContent = label;
      }
    });
  }
</script>
