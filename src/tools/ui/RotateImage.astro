---
import Icon from '../../components/Icon.astro';
---

<div class="ftool" id="tool-rotate">
  <div class="rt-options">
    <div class="field">
      <span class="field-label">Operation</span>
      <div class="seg" role="radiogroup" aria-label="Rotation or flip">
        <button type="button" class="seg-btn is-active" data-op="90" aria-pressed="true">↻ 90°</button>
        <button type="button" class="seg-btn" data-op="180" aria-pressed="false">180°</button>
        <button type="button" class="seg-btn" data-op="270" aria-pressed="false">↺ 270°</button>
        <button type="button" class="seg-btn" data-op="flipH" aria-pressed="false">Flip ⇋</button>
        <button type="button" class="seg-btn" data-op="flipV" aria-pressed="false">Flip ⇅</button>
      </div>
    </div>

    <div class="field" style="max-width:220px">
      <span class="field-label">Output format</span>
      <select class="select" data-format aria-label="Output format">
        <option value="keep">Same as original</option>
        <option value="image/jpeg">JPG</option>
        <option value="image/png">PNG</option>
        <option value="image/webp" selected>WebP</option>
      </select>
    </div>

    <p class="rt-info">New settings apply when you press “Rotate” — or change files.</p>
  </div>

  <div data-notice hidden></div>

  <div class="dropzone" data-dropzone>
    <input type="file" data-file-input multiple hidden />
    <span class="dz-icon" aria-hidden="true"><Icon name="upload" size={24} /></span>
    <h3>Drag & drop your images here</h3>
    <p>or click to browse · JPG, PNG, WebP · up to 50 MB per file</p>
    <span class="btn btn-primary btn-sm dz-cta" aria-hidden="true">Choose images</span>
  </div>

  <div class="ftool-actions">
    <span class="ftool-count" data-count aria-live="polite"></span>
    <span class="ftool-actions-btns">
      <button type="button" class="btn btn-ghost btn-sm" data-clear-all hidden>Start over</button>
      <button type="button" class="btn btn-accent btn-sm" data-go hidden>Rotate</button>
      <button type="button" class="btn btn-primary btn-sm" data-download-all hidden>Download all (ZIP)</button>
    </span>
  </div>

  <ul class="file-list" data-file-list role="list" aria-label="Images to rotate"></ul>

  <div class="handoff-chip" data-handoff hidden>
    <Icon name="spark" size={16} />
    <span>Continue with <strong data-handoff-name></strong> from the previous tool?</span>
    <button type="button" class="btn btn-sm btn-ghost" data-handoff-use>Use this file</button>
    <button type="button" class="icon-btn" data-handoff-dismiss aria-label="Dismiss">✕</button>
  </div>
</div>

<style>
  .rt-options {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 22px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
  }
  .seg {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
    flex-wrap: wrap;
  }
  .seg-btn {
    padding: 8px 16px;
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    transition: all 0.18s var(--ease);
  }
  .seg-btn.is-active {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }
  .rt-info {
    font-size: 0.8rem;
    color: var(--faint);
  }
  .ftool-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .ftool-count {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }
  .ftool-actions-btns {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>

<script>
  import { mountFileTool } from '../../lib/fileui.js';
  import { decodeImage, renameWithExt } from '../../lib/image.js';
  import { toast } from '../../lib/ui.js';
  import { saveHandoff, mountHandoffChip } from '../../lib/handoff.js';

  const root = document.getElementById('tool-rotate');
  if (root) {
    let op = '90';
    const formatSel = root.querySelector('[data-format]');
    const goBtn = root.querySelector('[data-go]');

    root.querySelectorAll('[data-op]').forEach((btn) => {
      btn.addEventListener('click', () => {
        op = btn.dataset.op;
        root.querySelectorAll('[data-op]').forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });
      });
    });

    const api = mountFileTool(root, {
      acceptTypes: ['image/jpeg', 'image/png', 'image/webp'],
      acceptExts: ['.jpg', '.jpeg', '.png', '.webp'],
      autoProcess: false,
      process: async (item) => {
        let format = formatSel.value;
        if (format === 'keep') {
          format = item.file.type === 'image/png' ? 'image/png' : item.file.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
        }
        const img = await decodeImage(item.file);
        try {
          const rotated = op === '90' || op === '270';
          const w = rotated ? img.height : img.width;
          const h = rotated ? img.width : img.height;
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          if (format === 'image/jpeg') {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, w, h);
          }
          ctx.save();
          ctx.translate(w / 2, h / 2);
          if (op === '90') ctx.rotate(Math.PI / 2);
          else if (op === '180') ctx.rotate(Math.PI);
          else if (op === '270') ctx.rotate(-Math.PI / 2);
          else if (op === 'flipH') ctx.scale(-1, 1);
          else if (op === 'flipV') ctx.scale(1, -1);
          ctx.drawImage(img.source, -img.width / 2, -img.height / 2);
          ctx.restore();
          const blob = await new Promise((resolve, reject) => {
            canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Conversion failed. Try another output format.'))), format, 0.92);
          });
          const ext = format === 'image/png' ? 'png' : format === 'image/webp' ? 'webp' : 'jpg';
          return { blob, name: renameWithExt(item.file.name, ext), meta: `${w} × ${h}` };
        } finally {
          img.close();
        }
      },
      onListChange: (items) => {
        goBtn.hidden = items.length === 0;
        const last = [...items].reverse().find((i) => i.status === 'done' && i.result?.blob);
        if (last) saveHandoff({ fromTool: 'image-rotator', name: last.result.name, type: last.result.blob.type, blob: last.result.blob });
      },
    });

    goBtn.addEventListener('click', async () => {
      goBtn.disabled = true;
      goBtn.textContent = 'Working…';
      try {
        await api.processAll();
        toast('Done — your rotated images are ready to download.', 'success');
      } finally {
        goBtn.disabled = false;
        goBtn.textContent = 'Rotate';
      }
    });

    mountHandoffChip(root, api, 'image/');
  }
</script>
