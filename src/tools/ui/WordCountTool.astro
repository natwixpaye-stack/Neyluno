---
import Icon from '../../components/Icon.astro';
---

<div class="wc-tool" id="tool-wordcount">
  <div class="wc-toolbar">
    <span class="wc-toolbar-label">Your text stays in your browser — nothing is stored or sent.</span>
    <span class="wc-toolbar-btns">
      <button type="button" class="btn btn-ghost btn-sm" data-sample>Example</button>
      <button type="button" class="btn btn-ghost btn-sm" data-clear>Clear</button>
    </span>
  </div>

  <textarea
    class="textarea wc-textarea"
    data-input
    rows="10"
    placeholder="Paste or type your text here…"
    aria-label="Text to analyze"
    spellcheck="false"></textarea>

  <div class="stat-grid wc-stats" aria-live="polite">
    <div class="stat">
      <div class="stat-value accent" data-stat-words>0</div>
      <div class="stat-label">Words</div>
    </div>
    <div class="stat">
      <div class="stat-value" data-stat-chars>0</div>
      <div class="stat-label">Characters</div>
    </div>
    <div class="stat">
      <div class="stat-value" data-stat-charsns>0</div>
      <div class="stat-label">Chars, no spaces</div>
    </div>
    <div class="stat">
      <div class="stat-value" data-stat-sentences>0</div>
      <div class="stat-label">Sentences</div>
    </div>
    <div class="stat">
      <div class="stat-value" data-stat-paragraphs>0</div>
      <div class="stat-label">Paragraphs</div>
    </div>
    <div class="stat">
      <div class="stat-value" data-stat-lines>0</div>
      <div class="stat-label">Lines</div>
    </div>
    <div class="stat">
      <div class="stat-value" data-stat-reading>—</div>
      <div class="stat-label">Reading time</div>
    </div>
  </div>
</div>

<style>
  .wc-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .wc-toolbar-label {
    font-size: 0.8rem;
    color: var(--faint);
  }

  .wc-toolbar-btns {
    display: flex;
    gap: 8px;
  }

  .wc-textarea {
    min-height: 260px;
    font-size: 1rem;
    line-height: 1.7;
    transition: border-color 0.18s, box-shadow 0.18s;
  }

  .wc-stats {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 12px;
  }

  .stat {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    text-align: center;
  }

  .stat .stat-value {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 700;
  }

  .stat-value.accent {
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--faint);
    margin-top: 4px;
  }
</style>

<script>
  import { countText } from '../../lib/text.js';

  const root = document.getElementById('tool-wordcount');
  if (root) {
    const input = root.querySelector('[data-input]');
    const el = {
      words: root.querySelector('[data-stat-words]'),
      chars: root.querySelector('[data-stat-chars]'),
      charsns: root.querySelector('[data-stat-charsns]'),
      sentences: root.querySelector('[data-stat-sentences]'),
      paragraphs: root.querySelector('[data-stat-paragraphs]'),
      lines: root.querySelector('[data-stat-lines]'),
      reading: root.querySelector('[data-stat-reading]'),
    };

    let queued = false;
    function update() {
      queued = false;
      const stats = countText(input.value);
      el.words.textContent = stats.words.toLocaleString('en-US');
      el.chars.textContent = stats.chars.toLocaleString('en-US');
      el.charsns.textContent = stats.charsNoSpaces.toLocaleString('en-US');
      el.sentences.textContent = stats.sentences.toLocaleString('en-US');
      el.paragraphs.textContent = stats.paragraphs.toLocaleString('en-US');
      el.lines.textContent = stats.lines.toLocaleString('en-US');
      el.reading.textContent = stats.words === 0 ? '—' : stats.readingTimeMin <= 1 ? '≈ 1 min' : `≈ ${stats.readingTimeMin} min`;
    }

    input.addEventListener('input', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    });

    root.querySelector('[data-clear]').addEventListener('click', () => {
      input.value = '';
      update();
      input.focus();
    });

    root.querySelector('[data-sample]').addEventListener('click', () => {
      input.value = `The Fox and the Crow

A crow sat high in a tree, a piece of cheese in her beak. A fox, drawn by the smell, stopped beneath the branches and looked up. "Good morning, beautiful creature," he said. "Your feathers shine like polished ink, and I am sure your voice must match your beauty."

Flattered, the crow opened her beak to sing — and down fell the cheese. The fox caught it neatly and added, "A word of advice: don't trade your dinner for a compliment."

The crow, embarrassed but wiser, decided then and there that she wouldn't fall for flattery again.`;
      update();
    });

    update();
  }
</script>
