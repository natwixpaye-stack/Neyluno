---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
import { tools } from '../data/tools.js';
---

<BaseLayout
  title="À propos"
  description={`${site.name} : des outils web gratuits qui traitent vos fichiers directement dans le navigateur. Aucun compte, aucun upload, aucun pistage.`}
  path="/a-propos/"
>
  <div class="container about-page">
    <span class="eyebrow">À propos</span>
    <h1>Des outils utiles, sans la contrepartie cachée.</h1>

    <div class="prose">
      <p>
        {site.name} est né d'un constat simple : pour une tâche de trois secondes — convertir une image,
        fusionner deux PDF, compter des mots — on se retrouve trop souvent sur des sites lents, couverts de
        publicités intrusives, qui uploadent vos fichiers sur leurs serveurs « pour traiter » ce que votre
        navigateur sait déjà faire.
      </p>

      <h2>Le principe : votre navigateur fait le travail</h2>
      <p>
        Les navigateurs modernes embarquent tout ce qu'il faut : un moteur de rendu d'images (Canvas), un
        générateur aléatoire cryptographique (Web Crypto), et des bibliothèques open source robustes comme
        <strong>pdf-lib</strong> pour manipuler les PDF. {site.name} assemble ces briques pour que chaque outil
        fonctionne <strong>entièrement chez vous</strong>.
      </p>
      <p>
        Conséquences concrètes : les outils sont rapides (pas d'aller-retour serveur), privés (rien n'est
        transmis ni stocké), et gratuits (aucun coût de calcul à répercuter).
      </p>

      <h2>Ce que nous ne faisons pas</h2>
      <ul>
        <li>Pas de compte obligatoire, ni d'inscription « pour débloquer » une fonction.</li>
        <li>Pas d'envoi de vos fichiers vers un serveur.</li>
        <li>Pas de tracking publicitaire invasif.</li>
        <li>Pas de limite artificielle du type « 2 conversions gratuites par jour ».</li>
      </ul>

      <h2>Et demain ?</h2>
      <p>
        Le site est conçu pour rester léger et extensible : de nouveaux outils s'ajoutent sans toucher à
        l'existant. Si un jour de la publicité apparaît, elle restera discrète, clairement étiquetée, et ne
        bloquera jamais un bouton ni un résultat.
      </p>
      <p>
        Aujourd'hui, {tools.length} outils sont disponibles. Consultez la
        <a href="/confidentialite/">politique de confidentialité</a> pour le détail de ce qui est (et n'est pas)
        collecté : spoiler, c'est vite lu.
      </p>
    </div>

    <div class="about-cards">
      <div class="about-card">
        <span class="ac-icon"><Icon name="lock" size={20} /></span>
        <h3>Privé par conception</h3>
        <p>Le traitement local n'est pas une option cochée : c'est l'architecture entière du site.</p>
      </div>
      <div class="about-card">
        <span class="ac-icon"><Icon name="bolt" size={20} /></span>
        <h3>Rapide par défaut</h3>
        <p>Pages statiques, scripts minimaux, aucun framework lourd : ça charge vite, même en 4G.</p>
      </div>
      <div class="about-card">
        <span class="ac-icon"><Icon name="globe" size={20} /></span>
        <h3>Ouvert à tous</h3>
        <p>Accessible au clavier, compatible lecteurs d'écran, utilisable sur mobile comme sur desktop.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: clamp(40px, 7vw, 72px);
    padding-bottom: 40px;
  }

  h1 {
    font-size: clamp(2rem, 4.6vw, 3rem);
    max-width: 720px;
    margin-bottom: 28px;
  }

  .about-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 48px;
  }

  .about-card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--panel);
  }

  .ac-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    margin-bottom: 14px;
  }

  .about-card h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }

  .about-card p {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
