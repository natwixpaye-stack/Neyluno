---
/** Une page statique par outil, générée depuis le registre. */
import ToolLayout from '../../layouts/ToolLayout.astro';
import { tools } from '../../data/tools.js';

import JpgWebp from '../../tools/ui/JpgWebp.astro';
import PngWebp from '../../tools/ui/PngWebp.astro';
import CompressImage from '../../tools/ui/CompressImage.astro';
import ResizeImage from '../../tools/ui/ResizeImage.astro';
import ImageToPdf from '../../tools/ui/ImageToPdf.astro';
import MergePdf from '../../tools/ui/MergePdf.astro';
import QrTool from '../../tools/ui/QrTool.astro';
import PercentTool from '../../tools/ui/PercentTool.astro';
import PasswordTool from '../../tools/ui/PasswordTool.astro';
import WordCountTool from '../../tools/ui/WordCountTool.astro';

const UI_MAP = {
  'jpg-vers-webp': JpgWebp,
  'png-vers-webp': PngWebp,
  'compresser-image': CompressImage,
  'redimensionner-image': ResizeImage,
  'image-en-pdf': ImageToPdf,
  'fusionner-pdf': MergePdf,
  'generer-qr-code': QrTool,
  'calculateur-pourcentage': PercentTool,
  'generateur-mot-de-passe': PasswordTool,
  'compteur-de-mots': WordCountTool,
};

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const UI = UI_MAP[tool.slug];

if (!UI) {
  throw new Error(`Outil sans interface : ${tool.slug}`);
}
---

<ToolLayout tool={tool}>
  <UI />
</ToolLayout>
