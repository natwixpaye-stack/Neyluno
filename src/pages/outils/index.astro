---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { categories } from '../../data/site.js';
import { tools } from '../../data/tools.js';
---

<BaseLayout
  title="Tous les outils gratuits"
  description={`Les ${tools.length} outils QuickTools : conversion d'images, compression, PDF, QR codes, calculs et plus — gratuits, sans compte, directement dans le navigateur.`}
  path="/outils/"
>
  <div class="container page-top">
    <span class="eyebrow">Catalogue</span>
    <h1>Tous les outils</h1>
    <p class="page-sub">
      {tools.length} outils gratuits, sans inscription, qui traitent tout dans votre navigateur.
    </p>

    <div class="tools-grid">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>

    <h2 class="cat-title">Par catégorie</h2>
    <div class="cat-row">
      {categories
        .filter((c) => tools.some((t) => t.category === c.slug))
        .map((c) => (
          <a class="cat-chip" href={`/categories/${c.slug}/`} style={`--hue:${c.hue}`}>
            <span class="cat-dot" aria-hidden="true" />
            {c.name}
            <span class="cat-count">{tools.filter((t) => t.category === c.slug).length}</span>
          </a>
        ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-top {
    padding-top: clamp(40px, 7vw, 72px);
    padding-bottom: 40px;
  }

  h1 {
    font-size: clamp(2rem, 4.6vw, 3rem);
    margin-bottom: 12px;
  }

  .page-sub {
    color: var(--muted);
    margin-bottom: 36px;
    max-width: 560px;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 16px;
  }

  .cat-title {
    font-size: 1.3rem;
    margin: 48px 0 18px;
  }

  .cat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s var(--ease);
  }

  .cat-chip:hover {
    border-color: color-mix(in srgb, var(--hue) 45%, transparent);
    transform: translateY(-2px);
  }

  .cat-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--hue);
  }

  .cat-count {
    color: var(--faint);
    font-size: 0.8rem;
  }
</style>
