---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas (ou plus)." path="/404/" noindex>
  <div class="container nf">
    <span class="nf-code" aria-hidden="true">404</span>
    <h1>Cette page a pris des vacances.</h1>
    <p>Le lien est peut-être erroné, ou la page a été déplacée. Les outils, eux, sont toujours là.</p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
      <button type="button" class="btn btn-ghost" data-search-open>Rechercher un outil</button>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    padding: clamp(80px, 14vh, 150px) 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .nf-code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 700;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
  }
  .nf h1 {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
  }
  .nf p {
    color: var(--muted);
    max-width: 420px;
  }
  .nf-actions {
    display: flex;
    gap: 12px;
    margin-top: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
