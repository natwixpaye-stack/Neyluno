---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/Icon.astro';
import { site, categories } from '../data/site.js';
import { tools, popularActions, getTool } from '../data/tools.js';

const path = '/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL(path, Astro.site).href,
    description: site.tagline,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Web',
    description: site.shortDescription,
    url: new URL(path, Astro.site).href,
    inLanguage: 'en',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const guides = [
  { slug: 'reduce-image-size-for-email', title: 'How to reduce image size for email', blurb: 'The exact settings that get attachments under 10 MB without visible quality loss.' },
  { slug: 'convert-webp-to-jpg', title: 'Convert WebP to JPG when nothing opens it', blurb: 'Why WebP files confuse older apps, and the fastest way to make them universal.' },
  { slug: 'compress-pdf-for-email', title: 'Compress a PDF for email (honestly)', blurb: 'What actually shrinks a PDF, what only pretends to, and when to split instead.' },
  { slug: 'create-a-favicon', title: 'Create a favicon that works everywhere', blurb: 'ICO, apple-touch-icon, PWA icons: the complete set, generated in one step.' },
  { slug: 'strong-passwords-guide', title: 'What makes a password strong in 2026', blurb: 'Length beats complexity — the numbers behind it, and how to generate good ones.' },
];
---

<BaseLayout title="Free online tools — images, PDF, text" description={site.shortDescription} path={path} jsonLd={jsonLd}>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="container hero-content">
      <span class="badge hero-badge reveal"><span class="dot"></span>100% local · free · no account</span>
      <h1 class="reveal">
        Get things done. <span class="gradient-text">Fast.</span>
      </h1>
      <p class="hero-sub reveal">
        {tools.length} free tools for images, PDFs, text and everyday tasks — everything runs in your
        browser, your files never leave your device.
      </p>

      <div class="hero-search reveal" role="search">
        <Icon name="search" size={19} />
        <input
          type="search"
          data-hero-search
          placeholder="What do you want to do?"
          aria-label="What do you want to do? Search tools"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" class="btn btn-primary" data-search-open>Search</button>
      </div>

      <div class="hero-chips reveal" aria-label="Popular quick actions">
        <span class="hero-chips-label">Popular:</span>
        {popularActions.map((a) => (
          <a href={`/tools/${a.slug}/`} class="hero-chip">
            <Icon name={a.icon} size={13} /> {a.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PERSONAL (recents & favorites) ============ -->
  <section class="section personal" id="personal" hidden>
    <div class="container">
      <div class="personal-row" id="fav-row" hidden>
        <h2 class="personal-title"><Icon name="star" size={15} /> Favorites</h2>
        <div class="personal-chips" data-fav-chips></div>
      </div>
      <div class="personal-row" id="recents-row" hidden>
        <h2 class="personal-title"><Icon name="clock" size={15} /> Recent</h2>
        <div class="personal-chips" data-recents-chips></div>
      </div>
    </div>
  </section>

  <!-- ================= TOOLS ================= -->
  <section class="section" id="tools">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Toolbox</span>
        <h2>{tools.length} tools, zero friction</h2>
        <p class="muted">Drop a file or paste some text — the result is ready in seconds.</p>
      </div>

      <div class="filter-bar reveal" role="group" aria-label="Filter tools by category">
        <button type="button" class="filter-chip is-active" data-filter="all">All</button>
        {categories.filter((c) => tools.some((t) => t.category === c.slug)).map((c) => (
          <button type="button" class="filter-chip" data-filter={c.slug} style={`--hue:${c.hue}`}>
            {c.name}
          </button>
        ))}
      </div>

      <div class="tools-grid">
        {tools.map((tool, i) => (
          <div class="reveal" style={`transition-delay:${Math.min(i * 30, 300)}ms`} data-tool-wrap={tool.category}>
            <ToolCard tool={tool} />
          </div>
        ))}
      </div>

      <p class="all-tools-link"><a href="/tools/" class="btn btn-ghost">Browse all tools <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>

  <!-- ================= WORKFLOWS ================= -->
  <section class="section">
    <div class="container">
      <div class="wf-band reveal">
        <div class="wf-copy">
          <span class="eyebrow">The differentiator</span>
          <h2>Chain tools into workflows</h2>
          <p>
            Resize, then compress, then convert — in one pass over your whole batch. Build the pipeline,
            save it locally, reuse it whenever you need. Results come out as a single ZIP.
          </p>
          <a href="/workflows/" class="btn btn-primary">Build a workflow <Icon name="arrow-right" size={16} /></a>
        </div>
        <ol class="wf-demo" aria-label="Example workflow: resize, compress, convert">
          <li><span class="wf-step-n">1</span> Resize <span class="wf-meta">max 1920 px</span></li>
          <li class="wf-arrow" aria-hidden="true"></li>
          <li><span class="wf-step-n">2</span> Compress <span class="wf-meta">quality 80%</span></li>
          <li class="wf-arrow" aria-hidden="true"></li>
          <li><span class="wf-step-n">3</span> Convert <span class="wf-meta">to WebP</span></li>
          <li class="wf-arrow" aria-hidden="true"></li>
          <li class="wf-out"><Icon name="download" size={15} /> ZIP</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= GUIDES ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Guides</span>
        <h2>Short answers to real questions</h2>
        <p class="muted">Practical, honest, no filler — written by people who actually use these tools.</p>
      </div>
      <div class="guides-grid">
        {guides.map((g, i) => (
          <a href={`/guides/${g.slug}/`} class="card guide-card reveal" style={`transition-delay:${i * 60}ms`}>
            <h3>{g.title}</h3>
            <p>{g.blurb}</p>
            <span class="guide-cta">Read the guide <Icon name="arrow-right" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHY ================= -->
  <section class="section why-section">
    <div class="container why-grid">
      <div class="why-left reveal">
        <span class="eyebrow">Why {site.name}</span>
        <h2>Private because of how it's built, not because of a promise.</h2>
        <p class="muted">
          Most “online tools” upload your files to a server first. Here, your browser does the whole job —
          you can watch the Network tab and see nothing leave your device.
        </p>
      </div>
      <div class="why-stats">
        <div class="why-stat reveal">
          <span class="why-num">0</span>
          <p><strong>server uploads.</strong><br /><span class="muted">Your files stay on your device from start to finish.</span></p>
        </div>
        <div class="why-stat reveal" style="transition-delay:80ms">
          <span class="why-num">100<span class="why-pct">%</span></span>
          <p><strong>local processing.</strong><br /><span class="muted">Canvas, Web Crypto, pdf-lib: the web already knows how.</span></p>
        </div>
        <div class="why-stat reveal" style="transition-delay:160ms">
          <span class="why-num">0</span>
          <p><strong>accounts required.</strong><br /><span class="muted">No sign-up, no email, no hidden limits.</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-band reveal">
        <div class="cta-orb" aria-hidden="true"></div>
        <h2>What do you want to do?</h2>
        <p>Tell us the task — we'll find the tool.</p>
        <button type="button" class="btn btn-primary" data-search-open>
          <Icon name="search" size={16} /> Search {tools.length} tools
        </button>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(80px, 14vh, 150px) 0 clamp(70px, 11vh, 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 75% 60% at 50% 38%, black 20%, transparent 72%);
    opacity: 0.5;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    will-change: transform;
    animation: orb-float 16s ease-in-out infinite;
  }

  .hero-orb-a {
    width: 520px;
    height: 520px;
    left: -140px;
    top: -120px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 55%, transparent), transparent 70%);
    transform: translate3d(calc(var(--px, 0) * 18px), calc(var(--py, 0) * 14px), 0);
  }

  .hero-orb-b {
    width: 460px;
    height: 460px;
    right: -120px;
    bottom: -160px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 45%, transparent), transparent 70%);
    animation-delay: -8s;
    transform: translate3d(calc(var(--px, 0) * -22px), calc(var(--py, 0) * -16px), 0);
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 7.2vw, 4.8rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
    max-width: 850px;
  }

  .hero-sub {
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 620px;
  }

  .hero-search {
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(600px, 100%);
    margin-top: 10px;
    padding: 8px 8px 8px 22px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.6), 0 0 0 0 var(--glow);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s var(--ease);
  }

  .hero-search:focus-within {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.6), 0 0 44px -8px var(--glow);
    transform: translateY(-2px);
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-size: 1.05rem;
    padding: 12px 0;
    color: var(--text);
  }

  .hero-search input::placeholder {
    color: var(--faint);
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .hero-chips-label {
    color: var(--faint);
    margin-right: 4px;
  }

  .hero-chips a {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--muted);
    transition: all 0.18s var(--ease);
  }

  .hero-chips a:hover {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  /* ---------- FILTRES + GRILLE ---------- */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .filter-chip {
    padding: 9px 17px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 600;
    transition: all 0.2s var(--ease);
  }

  .filter-chip:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .filter-chip.is-active {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    border-color: transparent;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 16px;
  }

  .tools-grid [data-tool-wrap] {
    display: flex;
  }

  .tools-grid [data-tool-wrap] > :global(.tool-card) {
    flex: 1;
  }

  .tools-grid [data-tool-wrap].filtered-out {
    display: none;
  }

  /* ---------- POURQUOI ---------- */
  .why-section {
    border-block: 1px solid var(--border);
    background:
      radial-gradient(700px 380px at 12% 20%, var(--glow), transparent 70%),
      var(--bg-2);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
  }

  .why-left h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    margin-bottom: 18px;
  }

  .why-left p {
    font-size: 1.02rem;
    max-width: 480px;
  }

  .why-stats {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .why-stat {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 22px 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--panel);
    transition: transform 0.25s var(--ease), border-color 0.25s;
  }

  .why-stat:hover {
    transform: translateX(6px);
    border-color: var(--border-strong);
  }

  .why-num {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
    min-width: 92px;
  }

  .why-pct {
    font-size: 1.4rem;
  }

  .why-stat p {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* ---------- CTA ---------- */
  .cta-band {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: clamp(48px, 8vw, 84px) 28px;
    border-radius: var(--radius-l);
    border: 1px solid var(--border-strong);
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-band h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
  }

  .cta-band p {
    color: var(--muted);
  }

  .cta-orb {
    position: absolute;
    width: 620px;
    height: 340px;
    left: 50%;
    bottom: -220px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, color-mix(in srgb, var(--accent) 40%, transparent), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
    .steps-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .why-stat {
      gap: 16px;
      padding: 18px 20px;
    }
    .why-num {
      min-width: 70px;
      font-size: 2.1rem;
    }
  }

  /* ---------- Personal strip ---------- */
  .personal {
    padding-top: 0;
    padding-bottom: 8px;
  }

  .personal-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 10px 0;
  }

  .personal-title {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
    min-width: 96px;
  }

  .personal-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .p-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel);
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--muted);
    transition: border-color 0.18s, color 0.18s, transform 0.18s;
  }

  .p-chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  /* ---------- Workflows band ---------- */
  .wf-band {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    padding: clamp(28px, 5vw, 52px);
    border-radius: var(--radius-l);
    border: 1px solid var(--border-strong);
    background: var(--bg-2);
  }

  .wf-copy h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    margin-bottom: 12px;
  }

  .wf-copy p {
    color: var(--muted);
    margin-bottom: 22px;
    max-width: 480px;
  }

  .wf-demo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
  }

  .wf-demo li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--panel);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .wf-step-n {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent-grad);
    color: #241203;
    font-size: 0.75rem;
    font-weight: 800;
    flex: none;
  }

  .wf-meta {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--faint);
  }

  .wf-arrow {
    width: 1px;
    height: 10px;
    margin-left: 28px;
    background: var(--border-strong);
    padding: 0 !important;
    border: none !important;
  }

  .wf-out {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent) !important;
  }

  /* ---------- Guides ---------- */
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 14px;
  }

  .guide-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .guide-card h3 {
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .guide-card p {
    color: var(--muted);
    font-size: 0.87rem;
    line-height: 1.5;
  }

  .guide-cta {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--faint);
    transition: color 0.18s, gap 0.18s var(--ease);
  }

  .guide-card:hover .guide-cta {
    color: var(--accent);
    gap: 9px;
  }

  .all-tools-link {
    margin-top: 26px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .wf-band {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { rotatingPlaceholder } from '../lib/ui.js';
  import { getRecents, getFavorites } from '../lib/local.js';
  import { getTool } from '../data/tools.js';
  import { ICON_PATHS } from '../lib/icons.js';

  // Rotating example phrases in the hero bar
  rotatingPlaceholder(document.querySelector('[data-hero-search]'), [
    'What do you want to do?',
    'Make my photo smaller…',
    'Convert WebP to JPG…',
    'Merge two PDFs…',
    'Remove duplicate lines…',
    'Generate a strong password…',
  ]);

  // Category filter
  document.querySelectorAll('.filter-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const f = chip.dataset.filter;
      document.querySelectorAll('[data-tool-wrap]').forEach((w) => {
        w.style.display = f === 'all' || w.dataset.toolWrap === f ? '' : 'none';
      });
    });
  });

  // Favorites & recents strip
  function chipHtml(slug) {
    const t = getTool(slug);
    if (!t) return '';
    return `<a class="p-chip" href="/tools/${t.slug}/"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS[t.icon] || ''}</svg>${t.name}</a>`;
  }

  const favs = getFavorites();
  const recents = getRecents().map((e) => e.slug);
  const favRow = document.getElementById('fav-row');
  const recRow = document.getElementById('recents-row');
  const personal = document.getElementById('personal');

  if (favs.length) {
    favRow.querySelector('[data-fav-chips]').innerHTML = favs.map(chipHtml).join('');
    favRow.hidden = false;
  }
  if (recents.length) {
    recRow.querySelector('[data-recents-chips]').innerHTML = recents.map(chipHtml).join('');
    recRow.hidden = false;
  }
  if (favs.length || recents.length) personal.hidden = false;
</script>
