---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { site } from '../data/site.js';

const {
  title = site.name,
  description = site.shortDescription,
  path = '/',
  jsonLd = null,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, Astro.site);
const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
const ogImage = new URL('/og-cover.png', Astro.site);
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow" />}
    <meta name="theme-color" content="#07080d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5f2" media="(prefers-color-scheme: light)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme before paint: light / dark / system, no flash -->
    <script is:inline>
      (function () {
        var pref = null;
        try {
          pref = localStorage.getItem('qt-theme');
        } catch (e) {}
        var effective;
        if (pref === 'dark' || pref === 'light') {
          effective = pref;
        } else {
          try {
            effective = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          } catch (e) {
            effective = 'dark';
          }
        }
        document.documentElement.dataset.theme = effective;
        document.documentElement.dataset.themePref = pref === 'dark' || pref === 'light' ? pref : 'system';
      })();
    </script>

    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchModal />

    <script>
      import { initReveal, initSpotlight, initThemeToggle } from '../lib/ui.js';
      import { getFavorites, toggleFavorite } from '../lib/local.js';
      import { getTool } from '../data/tools.js';
      initThemeToggle();
      initReveal();
      initSpotlight();

      // Favorite buttons (cards + tool pages) — state kept in localStorage only
      function syncFavButtons() {
        const favs = getFavorites();
        document.querySelectorAll('[data-fav]').forEach((btn) => {
          const slug = btn.getAttribute('data-fav');
          const on = favs.includes(slug);
          btn.setAttribute('aria-pressed', String(on));
          const tool = getTool(slug);
          const label = tool ? tool.name : slug;
          btn.setAttribute('aria-label', `${on ? 'Remove' : 'Add'} ${label} ${on ? 'from' : 'to'} favorites`);
          if (btn.title) btn.title = on ? 'Remove from favorites' : 'Add to favorites';
        });
      }
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-fav]');
        if (!btn) return;
        e.preventDefault(); // cards are <a> links — the star must not navigate
        e.stopPropagation();
        toggleFavorite(btn.getAttribute('data-fav'));
        syncFavButtons();
      }, true);
      syncFavButtons();
    </script>
  </body>
</html>
