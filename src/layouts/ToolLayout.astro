---
/** Common structure for every tool page. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import Icon from '../components/Icon.astro';
import { site, getCategory } from '../data/site.js';
import { getRelatedTools, nextSteps } from '../data/tools.js';

const { tool } = Astro.props;
const cat = getCategory(tool.category);
const related = getRelatedTools(tool, 4);
const path = `/tools/${tool.slug}/`;
const next = (nextSteps[tool.slug] || []).map((n) => ({ ...n })).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    description: tool.shortDesc,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Web',
    url: new URL(path, Astro.site).href,
    inLanguage: 'en',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: tool.steps.join(' · '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={`${tool.name} — free, no sign-up`} description={tool.shortDesc} path={path} jsonLd={jsonLd}>
  <div class="container tool-page">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: cat.name, href: `/categories/${cat.slug}/` },
        { label: tool.name },
      ]}
    />

    <header class="tool-head">
      <div class="tool-head-icon" style={`--hue:${cat.hue}`} aria-hidden="true">
        <Icon name={tool.icon} size={26} />
      </div>
      <h1>{tool.name}</h1>
      <p class="tool-desc">{tool.description}</p>
      <div class="tool-badges">
        <span class="badge"><span class="dot"></span>Processed on your device</span>
        <span class="badge">Free</span>
        <span class="badge">No sign-up</span>
        <span class="tool-head-actions">
          <button type="button" class="chip-btn" data-fav={tool.slug} aria-pressed="false" aria-label={`Add ${tool.name} to favorites`}>
            <Icon name="star" size={14} /> Favorite
          </button>
          <button type="button" class="chip-btn" data-share>
            <Icon name="share" size={14} /> Share
          </button>
        </span>
      </div>
    </header>

    <section class="tool-panel panel" aria-label={`${tool.name} main tool area`}>
      <slot />

      {
        next.length > 0 && (
          <div class="what-next">
            <h3>Do more with your result</h3>
            <div class="what-next-links">
              {next.map((n) => (
                <a href={`/tools/${n.slug}/`}>
                  {n.label} <Icon name="arrow-right" size={14} />
                </a>
              ))}
            </div>
          </div>
        )
      }
    </section>

    <AdPlaceholder slot="tool-after-result" />

    <HowItWorks steps={tool.steps} />

    <FAQ items={tool.faq} />

    <RelatedTools tools={related} />

    <section class="tool-seo" aria-label="Learn more">
      <h2>Good to know</h2>
      <div class="prose" set:html={tool.seo} />
    </section>
  </div>

  <script>
    import { pushRecent } from '../lib/local.js';
    import { toast } from '../lib/ui.js';

    const slugMatch = location.pathname.match(/\/tools\/([^/]+)/);
    if (slugMatch) pushRecent(slugMatch[1]);

    // Share / copy link
    document.querySelectorAll('[data-share]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = location.href;
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url });
            return;
          } catch {
            /* fall through to clipboard */
          }
        }
        try {
          await navigator.clipboard.writeText(url);
          toast('Link copied to clipboard', 'success');
        } catch {
          toast('Could not copy the link automatically.', 'error');
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .tool-page {
    padding-top: 26px;
    padding-bottom: 30px;
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 6vw, 60px);
  }

  .tool-head {
    max-width: 760px;
  }

  .tool-head-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 18px;
    margin-bottom: 18px;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--hue) 25%, transparent);
  }

  .tool-head h1 {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    margin-bottom: 14px;
  }

  .tool-desc {
    color: var(--muted);
    font-size: 1.04rem;
    max-width: 640px;
  }

  .tool-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    align-items: center;
  }

  .tool-head-actions {
    display: inline-flex;
    gap: 8px;
    margin-left: 6px;
  }

  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    transition: color 0.18s, border-color 0.18s, background 0.18s;
  }

  .chip-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .chip-btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .chip-btn[aria-pressed='true'] :global(svg) {
    fill: currentColor;
  }

  .tool-panel {
    padding: clamp(20px, 4vw, 40px);
  }

  .tool-seo {
    max-width: 780px;
  }

  .tool-seo h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 18px;
  }
</style>
